---
import ThemeToggle from '../ui/ThemeToggle.astro';
import { frontmatter as nav } from '../../data/shared.md';

const navLinks = [
  { label: 'Platform', href: '/platform' },
];

const solutionsLinks = [
  { label: 'Customer Experience', href: '/solutions/customer-experience' },
  { label: 'FinOps', href: '/solutions/finops' },
  { label: 'Governance & Risk', href: '/solutions/governance' },
];

const companyLinks = [
  { label: 'Mission', href: '/company#mission' },
  { label: 'Values', href: '/company#values' },
  { label: 'Team', href: '/company#team' },
  { label: 'Why Us', href: '/why-us' },
];

const resourcesLinks = nav.resources ?? [
  { label: 'Blog', href: '/resources/blog' },
];

const currentPath = Astro.url.pathname;
---

<header class="nav-header" id="site-nav">
  <div class="nav-container">
    <!-- Logo — dark variant (default), light variant swapped in by CSS -->
    <a href="/" class="nav-logo" aria-label="HealthFoundry home">
      <img
        src="/images/logo.png"
        alt="HealthFoundry"
        class="nav-logo-img logo-dark"
      />
      <img
        src="/images/logo-light.jpg"
        alt="HealthFoundry"
        class="nav-logo-img logo-light"
      />
    </a>

    <!-- Desktop nav links -->
    <nav class="nav-links" aria-label="Main navigation">
      <a href="/platform" class:list={['nav-link', { active: currentPath === '/platform' }]}>
        Platform
      </a>

      <!-- Solutions dropdown -->
      <div class="nav-dropdown-group">
        <button class="nav-link nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          Solutions
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="dropdown-chevron">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>
        <div class="nav-dropdown-menu" role="menu">
          {solutionsLinks.map(link => (
            <a href={link.href} class="nav-dropdown-item" role="menuitem">{link.label}</a>
          ))}
        </div>
      </div>

      <!-- Company dropdown -->
      <div class="nav-dropdown-group">
        <button class="nav-link nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          Company
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="dropdown-chevron">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>
        <div class="nav-dropdown-menu" role="menu">
          {companyLinks.map(link => (
            <a href={link.href} class="nav-dropdown-item" role="menuitem">{link.label}</a>
          ))}
        </div>
      </div>

      <a href="/security" class:list={['nav-link', { active: currentPath === '/security' }]}>
        Security
      </a>

      <!-- Resources dropdown -->
      <div class="nav-dropdown-group">
        <button class="nav-link nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          Resources
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="dropdown-chevron">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>
        <div class="nav-dropdown-menu" role="menu">
          {resourcesLinks.map(link => (
            <a href={link.href} class="nav-dropdown-item" role="menuitem">{link.label}</a>
          ))}
        </div>
      </div>

      <a href="/careers" class:list={['nav-link', { active: currentPath === '/careers' }]}>
        Careers
      </a>
    </nav>

    <!-- Actions: theme toggle + CTA -->
    <div class="nav-actions">
      <ThemeToggle />
      <a href="/contact" class="nav-cta">Book a Call</a>
    </div>

    <!-- Mobile hamburger -->
    <button
      class="nav-mobile-toggle"
      id="mobile-menu-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>
  </div>

  <!-- Mobile menu overlay -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-inner">
      <!-- Theme toggle at top of mobile menu -->
      <div class="mobile-theme-row">
        <span class="mobile-theme-label">Theme</span>
        <ThemeToggle />
      </div>

      <nav class="mobile-nav" aria-label="Mobile navigation">
        <a href="/platform" class="mobile-nav-link">Platform</a>

        <div class="mobile-nav-section">
          <span class="mobile-nav-section-label">Solutions</span>
          {solutionsLinks.map(link => (
            <a href={link.href} class="mobile-nav-link mobile-nav-sub">{link.label}</a>
          ))}
        </div>

        <div class="mobile-nav-section">
          <span class="mobile-nav-section-label">Company</span>
          {companyLinks.map(link => (
            <a href={link.href} class="mobile-nav-link mobile-nav-sub">{link.label}</a>
          ))}
        </div>

        <a href="/security" class="mobile-nav-link">Security</a>

        <div class="mobile-nav-section">
          <span class="mobile-nav-section-label">Resources</span>
          {resourcesLinks.map(link => (
            <a href={link.href} class="mobile-nav-link mobile-nav-sub">{link.label}</a>
          ))}
        </div>

        <a href="/careers" class="mobile-nav-link">Careers</a>
      </nav>

      <a href="/contact" class="mobile-cta">Book a Call</a>
    </div>
  </div>
</header>

<style>
  /* ── Header shell ─────────────────────────────── */
  .nav-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--bg-nav);
    border-bottom: 1px solid var(--border-subtle);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .nav-header.scrolled {
    background: var(--bg-nav-scrolled);
    border-bottom-color: var(--border-default);
  }

  .nav-container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-padding);
    height: 64px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  /* ── Logo ─────────────────────────────────────── */
  .nav-logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .nav-logo-img {
    height: 32px;
    width: auto;
  }

  /* Default (dark): show dark logo only */
  .logo-dark  { display: block; }
  .logo-light { display: none; }

  /* Light mode: show light logo, hide dark */
  :global([data-theme="light"]) .logo-dark  { display: none; }
  :global([data-theme="light"]) .logo-light { display: block; }

  .nav-logo-text {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  /* ── Desktop nav ──────────────────────────────── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
  }

  .nav-link {
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--nav-link-color);
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--nav-link-hover);
    background: var(--bg-card);
  }

  .dropdown-chevron {
    transition: transform 0.2s ease;
  }

  /* ── Dropdown ─────────────────────────────────── */
  .nav-dropdown-group {
    position: relative;
  }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 200px;
    background: var(--nav-dropdown-bg);
    border: 1px solid var(--nav-dropdown-border);
    border-radius: 10px;
    padding: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .nav-dropdown-group:hover .nav-dropdown-menu,
  .nav-dropdown-group:focus-within .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-dropdown-group:hover .dropdown-chevron,
  .nav-dropdown-group:focus-within .dropdown-chevron {
    transform: rotate(180deg);
  }

  .nav-dropdown-item {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .nav-dropdown-item:hover {
    color: var(--text-primary);
    background: var(--bg-card-hover);
  }

  /* ── Nav actions ──────────────────────────────── */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .nav-cta {
    padding: 0.5rem 1.125rem;
    border-radius: 8px;
    font-size: var(--text-sm);
    font-weight: 600;
    background: var(--nav-cta-bg);
    color: var(--nav-cta-text);
    white-space: nowrap;
  }

  .nav-cta:hover {
    background: var(--btn-primary-hover-bg);
  }

  /* ── Mobile toggle button ─────────────────────── */
  .nav-mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 6px;
    background: none;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
  }

  .hamburger-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text-primary);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-mobile-toggle[aria-expanded="true"] .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-mobile-toggle[aria-expanded="true"] .hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  .nav-mobile-toggle[aria-expanded="true"] .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Mobile menu ──────────────────────────────── */
  .mobile-menu {
    display: none;
    position: fixed;
    top: 64px;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-default);
    overflow-y: auto;
    z-index: 99;
  }

  .mobile-menu.open {
    display: block;
  }

  .mobile-menu-inner {
    padding: 1.5rem var(--container-padding) 2rem;
    max-width: var(--container-max);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mobile-theme-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .mobile-theme-label {
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-weight: 500;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .mobile-nav-link:hover {
    background: var(--bg-card);
  }

  .mobile-nav-section {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-section-label {
    display: block;
    padding: 0.5rem 1rem 0.25rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .mobile-nav-sub {
    padding-left: 1.75rem;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .mobile-cta {
    display: block;
    text-align: center;
    padding: 0.875rem 1.5rem;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    background: var(--nav-cta-bg);
    color: var(--nav-cta-text);
    margin-top: 0.5rem;
  }

  /* ── Responsive ───────────────────────────────── */
  @media (max-width: 768px) {
    .nav-links,
    .nav-actions {
      display: none;
    }

    .nav-mobile-toggle {
      display: flex;
      margin-left: auto;
    }
  }
</style>

<script>
  // Scroll — add .scrolled class to header
  const header = document.getElementById('site-nav');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  // Mobile menu toggle
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('open');
    mobileMenu?.classList.toggle('open', !isOpen);
    mobileToggle.setAttribute('aria-expanded', String(!isOpen));
    mobileToggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
    mobileMenu?.setAttribute('aria-hidden', String(isOpen));
    document.body.style.overflow = isOpen ? '' : 'hidden';
  });

  // Close mobile menu on nav link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.remove('open');
      mobileToggle?.setAttribute('aria-expanded', 'false');
      mobileToggle?.setAttribute('aria-label', 'Open menu');
      mobileMenu.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    });
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu?.classList.contains('open')) {
      mobileMenu.classList.remove('open');
      mobileToggle?.setAttribute('aria-expanded', 'false');
      mobileMenu.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      mobileToggle?.focus();
    }
  });
</script>
