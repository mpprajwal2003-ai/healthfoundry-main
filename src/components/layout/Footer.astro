---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-grid">

      <!-- Column 1: Brand -->
      <div class="footer-col footer-brand">
        <a href="/" class="footer-logo-link" aria-label="HealthFoundry home">
          <img
            src="/images/logo.png"
            alt="HealthFoundry"
            class="footer-logo-img logo-dark"
            width="120"
            height="30"
          />
          <img
            src="/images/logo-light.jpg"
            alt="HealthFoundry"
            class="footer-logo-img logo-light"
            width="120"
            height="30"
          />
        </a>
        <p class="footer-tagline">The Intelligence Fabric for Healthcare Operations.</p>
        <p class="footer-address">HealthFoundry Private Limited, Bengaluru</p>
      </div>

      <!-- Column 2: Platform -->
      <div class="footer-col">
        <h4 class="footer-col-heading">Platform</h4>
        <nav aria-label="Platform links">
          <a href="/platform" class="footer-link">Intelligence Fabric</a>
          <a href="/solutions/customer-experience" class="footer-link">Customer Experience</a>
          <a href="/solutions/finops" class="footer-link">FinOps</a>
          <a href="/solutions/governance" class="footer-link">Governance &amp; Risk</a>
        </nav>
      </div>

      <!-- Column 3: Company -->
      <div class="footer-col">
        <h4 class="footer-col-heading">Company</h4>
        <nav aria-label="Company links">
          <a href="/company" class="footer-link">About Us</a>
          <a href="/why-us" class="footer-link">Why HealthFoundry</a>
          <a href="/security" class="footer-link">Security</a>
          <a href="/careers" class="footer-link">Careers</a>
          <a href="/blog" class="footer-link">Blog</a>
        </nav>
      </div>

      <!-- Column 4: Connect -->
      <div class="footer-col">
        <h4 class="footer-col-heading">Connect</h4>
        <nav aria-label="Connect links">
          <a href="/contact" class="footer-link">Book a Call</a>
          <a href="mailto:hello@healthfoundry.ai" class="footer-link">hello@healthfoundry.ai</a>
          <a
            href="https://linkedin.com/company/healthfoundry"
            class="footer-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>
        </nav>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {year} HealthFoundry Private Limited. All rights reserved.
      </p>
      <div class="footer-bottom-links">
        <a href="/privacy" class="footer-bottom-link">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--footer-bg);
    border-top: 1px solid var(--footer-border);
    margin-top: auto;
  }

  .footer-container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-padding);
    padding-top: 4rem;
    padding-bottom: 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--footer-border);
  }

  /* Brand column */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-logo-link {
    display: inline-block;
  }

  .footer-logo-img {
    height: 28px;
    width: auto;
    object-fit: contain;
  }

  /* Dark mode (default): show dark logo */
  .logo-dark  { display: block; }
  .logo-light { display: none; }

  /* Light mode: show light logo, hide dark */
  :global([data-theme="light"]) .logo-dark  { display: none; }
  :global([data-theme="light"]) .logo-light { display: block; }

  .footer-logo-text {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: var(--footer-text);
    line-height: 1.5;
    margin: 0;
  }

  .footer-address {
    font-size: var(--text-xs);
    color: var(--footer-text);
    margin: 0;
  }

  /* Column heading */
  .footer-col-heading {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-primary);
    margin: 0 0 1rem 0;
  }

  /* Nav in footer cols */
  .footer-col nav {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-link {
    font-size: var(--text-sm);
    color: var(--footer-link);
    line-height: 1.4;
  }

  .footer-link:hover {
    color: var(--footer-link-hover);
  }

  /* Bottom bar */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-copy {
    font-size: var(--text-xs);
    color: var(--footer-text);
    margin: 0;
  }

  .footer-bottom-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-bottom-link {
    font-size: var(--text-xs);
    color: var(--footer-text);
  }

  .footer-bottom-link:hover {
    color: var(--footer-link-hover);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
