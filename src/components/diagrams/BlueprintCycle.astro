---
// Outcomes-Driven Optimization Blueprint — circular 6-node flow
// Clockwise: Audit (top) → Discover → Design → Deploy → Optimise → Learn → back to Audit
// Uses inline SVG for arcs + CSS-positioned node cards outside the circle.
---

<div class="blueprint-cycle" aria-label="Outcomes-Driven Optimization Blueprint: Audit, Discover, Design, Deploy, Optimise, Learn — a continuous cycle">

  <!-- SVG: connecting arcs only — nodes are HTML positioned over it -->
  <div class="cycle-canvas" aria-hidden="true">
    <svg class="cycle-svg" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" overflow="visible">
      <!--
        6 nodes on a circle of radius 140, centre (200,200).
        Angles (clockwise from top): 270°, 330°, 30°, 90°, 150°, 210°
        i.e. nodes at:
          0 Audit    (200, 60)     — top
          1 Discover (321, 130)   — top-right
          2 Design   (321, 270)   — bottom-right
          3 Deploy   (200, 340)   — bottom
          4 Optimise (79, 270)    — bottom-left
          5 Learn    (79, 130)    — top-left
      -->

      <!-- Arc arrows: drawn as curved paths between node centres, shortened to not overlap labels -->
      <!-- 0→1: Audit → Discover -->
      <path class="arc-path"
        d="M 215 72 A 140 140 0 0 1 313 143"
        fill="none" marker-end="url(#arrow)" />
      <!-- 1→2: Discover → Design -->
      <path class="arc-path"
        d="M 328 155 A 140 140 0 0 1 328 245"
        fill="none" marker-end="url(#arrow)" />
      <!-- 2→3: Design → Deploy -->
      <path class="arc-path"
        d="M 313 257 A 140 140 0 0 1 215 328"
        fill="none" marker-end="url(#arrow)" />
      <!-- 3→4: Deploy → Optimise -->
      <path class="arc-path"
        d="M 185 328 A 140 140 0 0 1 87 257"
        fill="none" marker-end="url(#arrow)" />
      <!-- 4→5: Optimise → Learn -->
      <path class="arc-path"
        d="M 72 245 A 140 140 0 0 1 72 155"
        fill="none" marker-end="url(#arrow)" />
      <!-- 5→0: Learn → Audit (completes the loop) -->
      <path class="arc-path"
        d="M 87 143 A 140 140 0 0 1 185 72"
        fill="none" marker-end="url(#arrow)" />

      <!-- Arrowhead marker -->
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5"
          markerWidth="5" markerHeight="5" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" class="arrow-fill" />
        </marker>
      </defs>
    </svg>

    <!-- Node buttons — CSS-positioned over SVG -->
    <!-- 0: Audit — top (200, 60) → 50% left, calc for top -->
    <div class="node node-0">
      <div class="node-icon">
        <!-- search icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </div>
      <span class="node-label">Audit</span>
    </div>

    <!-- 1: Discover — top-right (321, 130) -->
    <div class="node node-1">
      <div class="node-icon">
        <!-- map icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
          <line x1="9" y1="3" x2="9" y2="18"/>
          <line x1="15" y1="6" x2="15" y2="21"/>
        </svg>
      </div>
      <span class="node-label">Discover</span>
    </div>

    <!-- 2: Design — bottom-right (321, 270) -->
    <div class="node node-2">
      <div class="node-icon">
        <!-- drafting-compass icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="5" r="2"/>
          <path d="M5.21 17.11a7 7 0 0 1 13.58 0"/>
          <line x1="12" y1="7" x2="8.5" y2="16"/>
          <line x1="12" y1="7" x2="15.5" y2="16"/>
        </svg>
      </div>
      <span class="node-label">Design</span>
    </div>

    <!-- 3: Deploy — bottom (200, 340) -->
    <div class="node node-3">
      <div class="node-icon">
        <!-- rocket icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
          <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
          <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
          <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
        </svg>
      </div>
      <span class="node-label">Deploy</span>
    </div>

    <!-- 4: Optimise — bottom-left (79, 270) -->
    <div class="node node-4">
      <div class="node-icon">
        <!-- refresh-cw icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
          <path d="M21 3v5h-5"/>
          <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
          <path d="M8 16H3v5"/>
        </svg>
      </div>
      <span class="node-label">Optimise</span>
    </div>

    <!-- 5: Learn — top-left (79, 130) -->
    <div class="node node-5">
      <div class="node-icon">
        <!-- bar-chart-2 icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10"/>
          <line x1="12" y1="20" x2="12" y2="4"/>
          <line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
      </div>
      <span class="node-label">Learn</span>
    </div>

  </div><!-- /.cycle-canvas -->

  <!-- Descriptions below the circle -->
  <div class="node-descriptions">
    <div class="desc-item reveal delay-100">
      <span class="desc-label">Audit</span>
      <span class="desc-text">Validate current KPIs and attribute performance gaps to root causes</span>
    </div>
    <div class="desc-item reveal delay-200">
      <span class="desc-label">Discover</span>
      <span class="desc-text">Map actual workflows — not just SOPs — across all significant variants</span>
    </div>
    <div class="desc-item reveal delay-300">
      <span class="desc-label">Design</span>
      <span class="desc-text">Specify agent interventions against validated bottlenecks with target KPIs</span>
    </div>
    <div class="desc-item reveal delay-100">
      <span class="desc-label">Deploy</span>
      <span class="desc-text">Staged pilot with change management built in — then broader rollout</span>
    </div>
    <div class="desc-item reveal delay-200">
      <span class="desc-label">Optimise</span>
      <span class="desc-text">Tune agent configuration as confidence builds and scope expands</span>
    </div>
    <div class="desc-item reveal delay-300">
      <span class="desc-label">Learn</span>
      <span class="desc-text">Track outcomes against KPIs and feed operational feedback back into agents</span>
    </div>
  </div>

</div>

<style>
  .blueprint-cycle {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  /* ── Canvas: SVG + positioned nodes ── */
  .cycle-canvas {
    position: relative;
    width: min(400px, 100%);
    /* height = width (square aspect ratio so SVG coords map correctly) */
    aspect-ratio: 1;
    flex-shrink: 0;
  }

  .cycle-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Arc paths */
  .arc-path {
    stroke: var(--layer-connector);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }

  /* Arrow marker fill */
  .arrow-fill {
    fill: var(--layer-connector);
  }

  /* ── Nodes: CSS-positioned, centred on the circle points ── */
  /*
    Circle r=140, centre (200,200) in SVG 400×400.
    SVG coordinate → CSS %:
      x% = x/400 * 100,  y% = y/400 * 100
    Offset by -50% of own size to centre the node on that point.

    Node positions:
      0 Audit    (200, 60)   → (50%, 15%)
      1 Discover (321, 130)  → (80.25%, 32.5%)
      2 Design   (321, 270)  → (80.25%, 67.5%)
      3 Deploy   (200, 340)  → (50%, 85%)
      4 Optimise (79, 270)   → (19.75%, 67.5%)
      5 Learn    (79, 130)   → (19.75%, 32.5%)
  */
  .node {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    transform: translate(-50%, -50%);
  }

  .node-0 { left: 50%;    top: 15%;   }
  .node-1 { left: 80.25%; top: 32.5%; }
  .node-2 { left: 80.25%; top: 67.5%; }
  .node-3 { left: 50%;    top: 85%;   }
  .node-4 { left: 19.75%; top: 67.5%; }
  .node-5 { left: 19.75%; top: 32.5%; }

  .node-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--diagram-bg);
    border: 1.5px solid var(--diagram-border);
    border-radius: 50%;
    color: var(--text-primary);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
    transition: background 0.25s ease, border-color 0.25s ease;
    flex-shrink: 0;
  }

  .node:hover .node-icon {
    background: var(--bg-card-hover);
    border-color: var(--border-strong);
  }

  .node-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-primary);
    white-space: nowrap;
  }

  /* ── Description grid below the circle ── */
  .node-descriptions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem 1.5rem;
    width: 100%;
    max-width: 720px;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.5rem;
  }

  .desc-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .desc-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .desc-text {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .node-descriptions {
      grid-template-columns: repeat(2, 1fr);
    }

    .node-icon {
      width: 38px;
      height: 38px;
    }

    .node-icon svg {
      width: 16px;
      height: 16px;
    }

    .node-label {
      font-size: 10px;
    }
  }

  @media (max-width: 420px) {
    .node-descriptions {
      grid-template-columns: 1fr;
    }
  }
</style>
