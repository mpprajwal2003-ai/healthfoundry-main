---
---

<section class="sec-mv reveal">
  <div class="container">

    <p class="section-label">Mission &amp; Values</p>

    <!-- SVG diagram — full-width up to 680px, centred -->
    <div class="diagram-wrap">
      <svg
        width="100%"
        viewBox="0 0 680 640"
        role="img"
        aria-labelledby="mv-title mv-desc"
        class="mv-svg"
      >
        <title id="mv-title">HealthFoundry mission, pillars and values</title>
        <desc id="mv-desc">
          Five mission pillars form a complete ring around the central mission
          circle. Four value circles sit at the cardinal positions. A byline
          reads: built by people who know healthcare from the inside.
        </desc>

        <!-- Outer orbit ring -->
        <circle
          cx="340" cy="310" r="210"
          fill="none"
          stroke="var(--border-default)"
          stroke-width="0.75"
          stroke-dasharray="3 5"
        />

        <!-- ══ PILLAR RING — 5 arc segments ══ -->

        <!-- Seg 1: Unify -->
        <g class="pillar-seg">
          <path
            stroke-width="0.75"
            d="M 286.4,230.4 A 96,96 0 0,1 396.5,232.3 L 418.8,203.5 A 132,132 0 0,0 265.2,201.0 Z"
          />
          <text class="pillar-label" x="340" y="207" text-anchor="middle" dominant-baseline="central">Unify</text>
        </g>

        <!-- Seg 2: Intelligence -->
        <g class="pillar-seg">
          <path
            stroke-width="0.75"
            d="M 399.1,234.3 A 96,96 0 0,1 431.3,339.7 L 465.9,351.3 A 132,132 0 0,0 421.2,206.3 Z"
          />
          <text class="pillar-label" x="448" y="271" text-anchor="middle" dominant-baseline="central">Intelligence</text>
        </g>

        <!-- Seg 3: Reliable -->
        <g class="pillar-seg">
          <path
            stroke-width="0.75"
            d="M 430.2,342.8 A 96,96 0 0,1 340,406 L 340,442 A 132,132 0 0,0 463.9,355.7 Z"
          />
          <text class="pillar-label" x="420" y="402" text-anchor="middle" dominant-baseline="central">Reliable</text>
        </g>

        <!-- Seg 4: Frictionless -->
        <g class="pillar-seg">
          <path
            stroke-width="0.75"
            d="M 336.6,405.9 A 96,96 0 0,1 248.7,339.7 L 214.1,351.3 A 132,132 0 0,0 335.5,442.0 Z"
          />
          <text class="pillar-label" x="260" y="402" text-anchor="middle" dominant-baseline="central">Frictionless</text>
        </g>

        <!-- Seg 5: Scale -->
        <g class="pillar-seg">
          <path
            stroke-width="0.75"
            d="M 247.7,336.5 A 96,96 0 0,1 283.5,232.3 L 265.2,201.0 A 132,132 0 0,0 214.1,351.3 Z"
          />
          <text class="pillar-label" x="232" y="271" text-anchor="middle" dominant-baseline="central">Scale</text>
        </g>

        <!-- ══ SPOKES ══ -->
        <line x1="340" y1="214" x2="340" y2="148" stroke="var(--border-default)" stroke-width="0.75"/>
        <line x1="436" y1="310" x2="472" y2="310" stroke="var(--border-default)" stroke-width="0.75"/>
        <line x1="340" y1="406" x2="340" y2="468" stroke="var(--border-default)" stroke-width="0.75"/>
        <line x1="244" y1="310" x2="208" y2="310" stroke="var(--border-default)" stroke-width="0.75"/>

        <!-- ══ VALUE CIRCLES ══ -->

        <!-- Top: Shared goals -->
        <g class="value-circle">
          <circle cx="340" cy="86" r="62" stroke-width="0.75"/>
          <text class="value-head" x="340" y="68" text-anchor="middle" dominant-baseline="central">Shared goals</text>
          <text class="value-sub"  x="340" y="86" text-anchor="middle" dominant-baseline="central">Your success</text>
          <text class="value-sub"  x="340" y="102" text-anchor="middle" dominant-baseline="central">is our success</text>
        </g>

        <!-- Right: Extreme ownership -->
        <g class="value-circle">
          <circle cx="536" cy="310" r="62" stroke-width="0.75"/>
          <text class="value-head" x="536" y="292" text-anchor="middle" dominant-baseline="central">Extreme</text>
          <text class="value-head" x="536" y="308" text-anchor="middle" dominant-baseline="central">ownership</text>
          <text class="value-sub"  x="536" y="326" text-anchor="middle" dominant-baseline="central">We close the loop</text>
        </g>

        <!-- Bottom: Rapid time to value -->
        <g class="value-circle">
          <circle cx="340" cy="532" r="62" stroke-width="0.75"/>
          <text class="value-head" x="340" y="514" text-anchor="middle" dominant-baseline="central">Rapid time</text>
          <text class="value-head" x="340" y="530" text-anchor="middle" dominant-baseline="central">to value</text>
          <text class="value-sub"  x="340" y="548" text-anchor="middle" dominant-baseline="central">8 weeks, not months</text>
        </g>

        <!-- Left: Craftsmanship -->
        <g class="value-circle">
          <circle cx="144" cy="310" r="62" stroke-width="0.75"/>
          <text class="value-head" x="144" y="298" text-anchor="middle" dominant-baseline="central" font-size="13">Craftsmanship</text>
          <text class="value-sub"  x="144" y="316" text-anchor="middle" dominant-baseline="central">Reliability &amp; delight</text>
        </g>

        <!-- ══ CENTRE: Mission ══ -->
        <g class="mission-centre">
          <circle cx="340" cy="310" r="92" stroke-width="1"/>
          <text class="mission-head" x="340" y="284" text-anchor="middle" dominant-baseline="central">Our mission</text>
          <text class="mission-sub"  x="340" y="308" text-anchor="middle" dominant-baseline="central">Building the system of</text>
          <text class="mission-sub"  x="340" y="326" text-anchor="middle" dominant-baseline="central">intelligence for healthcare</text>
        </g>

      </svg>
    </div>

    <!-- Byline — styled HTML for proper emphasis -->
    <p class="byline">Built by people who know healthcare from the inside.</p>

  </div>
</section>

<style>
  .sec-mv {
    background: var(--bg-tertiary);
    padding: 3rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .section-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--section-label-color);
    margin: 0 0 1.5rem;
    text-align: center;
  }

  /* ── Diagram ── */
  .diagram-wrap {
    max-width: 480px;
    margin: 0 auto 2rem;
  }

  .mv-svg {
    display: block;
    overflow: visible;
  }

  /* Pillar ring segments */
  .pillar-seg path {
    fill: var(--bg-card);
    stroke: var(--border-default);
  }

  .pillar-seg:hover path {
    fill: var(--bg-card-hover);
  }

  .pillar-label {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    fill: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  /* Value circles */
  .value-circle circle {
    fill: var(--domain-cx-muted);
    stroke: var(--domain-cx-border);
  }

  .value-circle:hover circle {
    fill: var(--domain-cx-muted);
  }

  .value-head {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    fill: var(--domain-cx);
  }

  .value-sub {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 9.5px;
    fill: var(--text-secondary);
  }

  /* Mission centre circle */
  .mission-centre circle {
    fill: var(--bg-card);
    stroke: var(--border-strong);
  }

  .mission-head {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    fill: var(--text-primary);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .mission-sub {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 10.5px;
    fill: var(--text-secondary);
  }

  /* ── Byline ── */
  .byline {
    text-align: center;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-style: italic;
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: -0.01em;
    line-height: 1.5;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
    max-width: 480px;
    margin-inline: auto;
  }

  /* ── Responsive ── */
  @media (max-width: 480px) {
    .diagram-wrap {
      margin-bottom: 2rem;
    }

    .team-byline {
      gap: 0.5rem 1rem;
    }
  }
</style>
