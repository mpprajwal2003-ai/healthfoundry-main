---
import { frontmatter } from '../../data/home.md';

const { label, titleLine1, titleLine2, painCards, prose } = frontmatter.problem;

const painIcons = {
  database: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/>',
  clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  bell: '<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>',
};
---

<section class="problem section-padding">
  <div class="container">
    <p class="section-label reveal">{label}</p>
    <h2 class="section-title reveal delay-100">
      {titleLine1}<br/>
      {titleLine2}
    </h2>

    <div class="problem-grid reveal delay-200">
      <!-- Left: 3 pain point cards -->
      <div class="pain-cards">
        {painCards.map((card) => (
          <div class="pain-card">
            <div class="pain-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                stroke-linejoin="round" aria-hidden="true" set:html={painIcons[card.icon]} />
            </div>
            <div class="pain-content">
              <h3 class="pain-title">{card.title}</h3>
              <p class="pain-desc">{card.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Right: prose -->
      <div class="problem-prose">
        {prose.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .problem {
    background: var(--bg-secondary);
  }

  .section-padding {
    padding: 5rem 0;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .section-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--section-label-color);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 3rem;
  }

  .problem-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* Pain cards */
  .pain-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pain-card {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .pain-card:hover {
    background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
  }

  .pain-icon {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--bg-highlight);
    border-radius: 0.5rem;
    flex-shrink: 0;
    padding: 0.625rem;
    color: var(--accent-primary);
  }

  .pain-icon svg {
    width: 20px;
    height: 20px;
  }

  .pain-content {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .pain-title {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.4;
  }

  .pain-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Prose */
  .problem-prose {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .problem-prose p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.75;
    margin: 0;
  }

  .problem-prose p:first-child {
    font-size: var(--text-lg);
    color: var(--text-primary);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .problem-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
