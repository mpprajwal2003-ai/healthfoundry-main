---
import StatCard from '../ui/StatCard.astro';
---

<section class="outcomes section-padding reveal">
  <div class="container">
    <p class="section-label">What to Expect</p>
    <h2 class="section-title">
      Indicative outcomes from deployed agents
    </h2>

    <div class="stats-grid">

      <!-- Customer CX column -->
      <div class="domain-column">
        <div class="domain-header" style="color: var(--domain-cx);">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          Customer CX
        </div>
        <StatCard
          value="30–50%"
          label="Improvement in care gap follow-up completion"
          domainColor="--domain-cx"
        />
        <StatCard
          value="20–35%"
          label="Reduction in appointment no-show rate"
          domainColor="--domain-cx"
        />
        <StatCard
          value="30–50 pp"
          label="Improvement in feedback coverage (inpatient + outpatient)"
          domainColor="--domain-cx"
        />
      </div>

      <!-- FinOps column -->
      <div class="domain-column">
        <div class="domain-header" style="color: var(--domain-finops);">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
            <polyline points="16 7 22 7 22 13"/>
          </svg>
          FinOps
        </div>
        <StatCard
          value="40–60%"
          label="Reduction in claim submission TAT"
          domainColor="--domain-finops"
        />
        <StatCard
          value="10–15 pp"
          label="Improvement in first-pass acceptance rate"
          domainColor="--domain-finops"
        />
        <StatCard
          value="40–60%"
          label="Reduction in query closure TAT"
          domainColor="--domain-finops"
        />
      </div>

      <!-- GRC column -->
      <div class="domain-column">
        <div class="domain-header" style="color: var(--domain-grc);">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
          GRC
        </div>
        <StatCard
          value="20–40%"
          label="Reduction in TAT breach rate by service type"
          domainColor="--domain-grc"
        />
        <StatCard
          value="Real-time"
          label="Risk identification — surfaced before findings, not after"
          domainColor="--domain-grc"
        />
        <StatCard
          value="8 Weeks"
          label="Median time to first measurable outcome across all domains"
        />
      </div>

    </div>

    <p class="caveat">
      Ranges based on design-phase targets refined from Audit findings. Actual outcomes vary by starting baseline.
    </p>
  </div>
</section>

<style>
  .outcomes {
    background: var(--bg-primary);
  }

  .section-padding {
    padding: 5rem 0;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .section-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--section-label-color);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 3rem;
    max-width: 600px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .domain-column {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .domain-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 0.25rem;
  }

  .caveat {
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-style: italic;
    text-align: center;
    margin: 0;
    padding-top: 0.5rem;
  }

  @media (max-width: 900px) {
    .stats-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
