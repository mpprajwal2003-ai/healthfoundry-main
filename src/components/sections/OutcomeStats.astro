---
import StatCard from '../ui/StatCard.astro';
import { frontmatter } from '../../data/home.md';

const { label, title, columns, caveat } = frontmatter.outcomes;

const domainIcons = {
  users: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  'trending-up': '<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
};
---

<section class="outcomes section-padding reveal">
  <div class="container">
    <p class="section-label">{label}</p>
    <h2 class="section-title">
      {title}
    </h2>

    <div class="stats-grid">
      {columns.map((col) => (
        <div class="domain-column">
          <div class="domain-header" style={`color: var(${col.color});`}>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true" set:html={domainIcons[col.icon]} />
            {col.domain}
          </div>
          {col.stats.map((stat) => (
            <StatCard
              value={stat.value}
              label={stat.label}
              domainColor={stat.noColor ? undefined : col.color}
            />
          ))}
        </div>
      ))}
    </div>

    <p class="caveat">
      {caveat}
    </p>
  </div>
</section>

<style>
  .outcomes {
    background: var(--bg-primary);
  }

  .section-padding {
    padding: 5rem 0;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .section-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--section-label-color);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 3rem;
    max-width: 600px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    /* header row + one row per stat card, all card rows equal height */
    grid-template-rows: auto repeat(3, 1fr);
    gap: 1.5rem 1.5rem;
    margin-bottom: 2rem;
  }

  .domain-column {
    display: grid;
    /* inherit the outer grid's row tracks so cards align across columns */
    grid-template-rows: subgrid;
    grid-row: 1 / -1;
    gap: 0.75rem;
  }

  .domain-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 0.25rem;
  }

  .caveat {
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-style: italic;
    text-align: center;
    margin: 0;
    padding-top: 0.5rem;
  }

  @media (max-width: 900px) {
    .stats-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      max-width: 480px;
      margin-left: auto;
      margin-right: auto;
    }

    /* stack columns normally instead of overlapping on the subgrid tracks */
    .domain-column {
      grid-template-rows: none;
      grid-row: auto;
    }
  }
</style>
