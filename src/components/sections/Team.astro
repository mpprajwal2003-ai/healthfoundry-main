---
const { label, title, intro, members } = Astro.props;
---

<section class="team section-padding reveal">
  <div class="container">
    <p class="section-label">{label}</p>
    <h2 class="section-title">
      {title}
    </h2>
    <p class="section-intro">
      {intro}
    </p>

    <div class="team-grid">
      {members.map((member) => (
        <a
          href={member.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="team-card"
          aria-label={`${member.name} — ${member.role} — LinkedIn`}
        >
          <div class="team-photo-wrap">
            <img
              src={member.photo}
              alt={member.name}
              class="team-photo"
              loading="lazy"
              width="120"
              height="120"
            />
          </div>
          <div class="team-info">
            <span class="team-name">{member.name}</span>
            <span class="team-role">{member.role}</span>
          </div>
          <div class="linkedin-icon" aria-hidden="true">
            <!-- LinkedIn icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
              fill="currentColor">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .team {
    background: var(--bg-secondary);
  }

  .section-padding {
    padding: 5rem 0;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .section-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--section-label-color);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
  }

  .section-intro {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 680px;
    margin: 0 0 3rem;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
  }

  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    padding: 1.5rem 1rem;
    background: var(--team-card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    text-decoration: none;
    position: relative;
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
  }

  .team-card:hover {
    background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
    transform: translateY(-3px);
  }

  .team-photo-wrap {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--team-avatar-border);
    flex-shrink: 0;
  }

  .team-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .team-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-align: center;
  }

  .team-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .team-role {
    font-size: var(--text-xs);
    color: var(--team-role-color);
    line-height: 1.4;
  }

  .linkedin-icon {
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .team-card:hover .linkedin-icon {
    color: #0077b5; /* LinkedIn brand colour — intentional, not a theme token */
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .team-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
