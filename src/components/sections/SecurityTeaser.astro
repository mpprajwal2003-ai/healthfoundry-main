---
---

<section class="trust-bar reveal">
  <div class="container">
    <div class="trust-inner">

      <div class="trust-left">
        <div class="trust-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>
        <span class="trust-headline">Enterprise-grade security, purpose-built for healthcare.</span>
      </div>

      <div class="trust-right">
        <span class="trust-badge">HIPAA</span>
        <span class="trust-badge">HITRUST CSF</span>
        <span class="trust-badge">Deployed in your infrastructure</span>
        <a href="/security" class="trust-link">
          Security posture
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .trust-bar {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.25rem 0;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .trust-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .trust-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .trust-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    color: var(--text-secondary);
    flex-shrink: 0;
  }

  .trust-headline {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .trust-right {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  .trust-badge {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  .trust-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    white-space: nowrap;
    margin-left: 0.25rem;
    transition: color 0.2s ease, gap 0.2s ease;
  }

  .trust-link:hover {
    color: var(--text-primary);
    gap: 0.5rem;
  }

  @media (max-width: 720px) {
    .trust-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.875rem;
    }
  }
</style>
