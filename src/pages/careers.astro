---
import Layout from '../layouts/Layout.astro';
import FooterCTA from '../components/sections/FooterCTA.astro';
import Button from '../components/ui/Button.astro';
import { frontmatter } from '../data/careers.md';

const { meta, hero, whyWork, positions } = frontmatter;

const whyIcons = {
  heart: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  users: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
};
---

<Layout
  title={meta.title}
  description={meta.description}
>

  <!-- ═══════════════════════════════════════════════════
       SECTION 1 — HERO
  ══════════════════════════════════════════════════════ -->
  <section class="sec-hero">
    <div class="container">
      <p class="hero-label">Careers</p>
      <h1 class="hero-h1">{hero.title}</h1>
      <p class="hero-sub">
        {hero.subtitle}
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 2 — WHY WORK HERE
  ══════════════════════════════════════════════════════ -->
  <section class="sec-why reveal">
    <div class="container">
      <p class="section-label">{whyWork.label}</p>
      <h2 class="section-h2">{whyWork.title}</h2>

      <div class="why-grid">
        {whyWork.cards.map((card, i) => (
          <div class={`why-card reveal delay-${(i + 1) * 100}`}>
            <div class="why-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" set:html={whyIcons[card.icon]} />
            </div>
            <h3 class="why-title">{card.title}</h3>
            <p class="why-desc">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 3 — OPEN POSITIONS
  ══════════════════════════════════════════════════════ -->
  <section class="sec-positions reveal">
    <div class="container">
      <p class="section-label">{positions.label}</p>
      <h2 class="section-h2">{positions.title}</h2>

      <!--
        NOTE: Real job openings are defined (commented out) in src/data/careers.md under `jobs:`.
        For now we show the "No open positions" placeholder below. To go live with the roles,
        uncomment `jobs:` in careers.md and restore the data-driven <div class="jobs-list"> block
        (git history / the migration notes have the exact markup).
      -->

      <!-- No open positions card -->
      <div class="no-positions-card reveal delay-100">
        <div class="no-pos-icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
            stroke-linejoin="round">
            <rect width="20" height="14" x="2" y="7" rx="2"/>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
          </svg>
        </div>
        <h3 class="no-pos-title">No open positions right now</h3>
        <p class="no-pos-desc">
          We don't have active listings at the moment, but we're always interested in
          exceptional people. If you're working at the intersection of healthcare and AI —
          as an engineer, clinician, data scientist, or revenue cycle specialist — send
          us a speculative application.
        </p>
        <a href="mailto:hello@healthfoundry.ai?subject=Speculative Application" class="no-pos-link">
          hello@healthfoundry.ai
        </a>
        <p class="no-pos-hint">
          Tell us who you are, what you've built, and why healthcare operations.
        </p>
      </div>

      <!-- Placeholder: what a listing looks like -->
      <div class="placeholder-section reveal delay-200">
        <p class="placeholder-label" aria-label="Example listing — not a real open role">
          Example listing
        </p>

        <div class="job-card job-card-placeholder">
          <div class="job-header">
            <div class="job-meta-stack">
              <h3 class="job-title">Senior AI/ML Engineer</h3>
              <div class="job-badges">
                <span class="badge badge-team">Platform Engineering</span>
                <span class="badge badge-location">Bengaluru, India</span>
                <span class="badge badge-type">Full-time</span>
              </div>
            </div>
            <span class="placeholder-tag" aria-hidden="true">Example only</span>
          </div>
          <p class="job-blurb">
            Work on the Intelligence Fabric core — agent orchestration, human-in-the-loop
            governance, and LLM observability. Deep experience with production ML systems
            and healthcare data standards preferred.
          </p>
          <Button href="mailto:hello@healthfoundry.ai" variant="secondary" size="sm">
            Express interest
          </Button>
        </div>
      </div>
    </div>
  </section>

  <FooterCTA />

</Layout>

<style>
  /* ── Shared ── */
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .section-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.5rem;
  }

  .section-h2 {
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 0 0 2.5rem;
  }

  /* ── Section 1: Hero ── */
  .sec-hero {
    padding: 5rem 0 4rem;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
    text-align: center;
  }

  .hero-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 1rem;
  }

  .hero-h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--text-primary);
    margin: 0 0 1.25rem;
  }

  .hero-sub {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto;
  }

  /* ── Section 2: Why ── */
  .sec-why {
    padding: 5rem 0;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .why-card {
    padding: 2rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .why-card:hover {
    background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
  }

  .why-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    color: var(--text-secondary);
    flex-shrink: 0;
  }

  .why-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .why-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.75;
    margin: 0;
  }

  /* ── Section 3: Positions ── */
  .sec-positions {
    padding: 5rem 0;
    background: var(--bg-primary);
  }

  /* No positions card */
  .no-positions-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 2.5rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    max-width: 640px;
    margin-bottom: 3rem;
  }

  .no-pos-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: 12px;
    color: var(--text-muted);
  }

  .no-pos-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .no-pos-desc {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .no-pos-link {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--border-default);
    padding-bottom: 1px;
    transition: border-color 0.2s ease;
  }

  .no-pos-link:hover {
    border-color: var(--text-primary);
  }

  .no-pos-hint {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
    font-style: italic;
  }

  /* Placeholder section */
  .placeholder-section {
    border-top: 1px solid var(--border-subtle);
    padding-top: 2.5rem;
  }

  .placeholder-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 1.25rem;
    font-style: italic;
  }

  /* Jobs list */
  .jobs-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Job card */
  .job-card {
    padding: 2rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 760px;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .job-card:hover {
    background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
  }

  .job-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.25rem;
  }

  .job-detail-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.625rem;
  }

  .job-detail-list {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .job-detail-list li {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .job-details {
      grid-template-columns: 1fr;
    }
  }

  .job-card-placeholder {
    opacity: 0.6;
    border-style: dashed;
  }

  .job-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .job-meta-stack {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .job-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .job-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .badge {
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    letter-spacing: 0.03em;
  }

  .badge-team {
    background: var(--domain-grc-muted);
    color: var(--domain-grc);
    border: 1px solid var(--domain-grc-border);
  }

  .badge-location {
    background: var(--bg-card);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }

  .badge-type {
    background: var(--domain-cx-muted);
    color: var(--domain-cx);
    border: 1px solid var(--domain-cx-border);
  }

  .placeholder-tag {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 0.2rem 0.625rem;
    white-space: nowrap;
    flex-shrink: 0;
    font-style: italic;
  }

  .job-blurb {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* ── Responsive ── */
  @media (max-width: 800px) {
    .why-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .no-positions-card {
      padding: 1.75rem;
    }
  }
</style>
