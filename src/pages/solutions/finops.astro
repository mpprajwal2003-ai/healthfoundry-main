---
import Layout from '../../layouts/Layout.astro';
import PayerIntelligenceFlow from '../../components/diagrams/PayerIntelligenceFlow.astro';
import WorkflowVariantTable from '../../components/diagrams/WorkflowVariantTable.astro';
import StatCard from '../../components/ui/StatCard.astro';
import FooterCTA from '../../components/sections/FooterCTA.astro';
import Button from '../../components/ui/Button.astro';
import { frontmatter } from '../../data/solutions-finops.md';

const { meta, hero, lifecycle, payer, pkg, agents, outcomes, variants } = frontmatter;
---

<Layout
  title={meta.title}
  description={meta.description}
>

  <!-- ═══════════════════════════════════════════════════
       SECTION 1 — HERO
  ══════════════════════════════════════════════════════ -->
  <section class="fo-hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-text">
          <div class="domain-pill">
            <!-- trending-up icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
              <polyline points="17 6 23 6 23 12"/>
            </svg>
            {hero.pill}
          </div>

          <h1 class="hero-h1">
            {hero.titleLine1}<br />
            <span class="hero-h1-accent">{hero.titleAccent}</span>
          </h1>

          <p class="hero-sub">
            {hero.subtitle}
          </p>

          <p class="hero-body">
            {hero.body}
          </p>

          <div class="hero-ctas">
            <Button href="/contact" variant="primary" size="lg">{hero.ctaPrimary}</Button>
            <Button href="/platform" variant="secondary" size="lg">{hero.ctaSecondary}</Button>
          </div>
        </div>

        <div class="hero-image reveal-left delay-200">
          <img
            src="/images/claims-snapshot.png"
            alt={hero.imageAlt}
            class="hero-screenshot"
            width="600"
            height="400"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 2 — CLAIMS LIFECYCLE
  ══════════════════════════════════════════════════════ -->
  <section class="fo-lifecycle reveal">
    <div class="container">
      <p class="section-label">{lifecycle.label}</p>
      <h2 class="section-h2">
        {lifecycle.titleLine1}<br class="br-desktop" />
        {lifecycle.titleLine2}
      </h2>
      <p class="section-intro">
        {lifecycle.intro}
      </p>

      <div class="rcm-domains">
        {lifecycle.domains.map((d, i) => (
          <div class={`rcm-domain-card reveal delay-${(i + 1) * 100}`}>
            <div class="rcm-domain-num">{d.num}</div>
            <h3 class="rcm-domain-title">{d.title}</h3>
            <p class="rcm-domain-desc">
              {d.desc}
            </p>
          </div>
        ))}
      </div>

      <div class="rcm-divider"></div>

      <h3 class="rcm-sub-heading">{lifecycle.subHeading}</h3>
      <p class="section-intro" style="margin-top: 0.75rem;">
        {lifecycle.subIntro}
      </p>

      <div class="lifecycle-diagram reveal">
        <img
          src="/images/claims_lifecycle_diagram.png"
          alt={lifecycle.diagramAlt}
          class="lifecycle-img"
          width="1200"
          height="auto"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 3 — PAYER INTELLIGENCE
  ══════════════════════════════════════════════════════ -->
  <section class="fo-payer reveal">
    <div class="container">
      <div class="payer-inner">
        <div class="payer-text">
          <p class="section-label">{payer.label}</p>
          <h2 class="section-h2">
            {payer.titleLine1}<br class="br-desktop" />
            {payer.titleLine2}
          </h2>
          <div class="payer-prose">
            {payer.prose.map((p) => (
              <p>{p}</p>
            ))}
            <p class="payer-note">
              {payer.note}
            </p>
          </div>
        </div>

        <div class="payer-diagram reveal-left delay-200">
          <PayerIntelligenceFlow />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 4 — PACKAGE PROFITABILITY
  ══════════════════════════════════════════════════════ -->
  <section class="fo-pkg reveal">
    <div class="container">
      <p class="section-label">{pkg.label}</p>
      <h2 class="section-h2">
        {pkg.titleLine1}<br class="br-desktop" />
        {pkg.titleLine2}
      </h2>
      <p class="section-intro">
        {pkg.intro}
      </p>

      <div class="pkg-flow">

        <!-- Step 1 -->
        <div class="pkg-step reveal delay-100">
          <div class="pkg-step-icon" aria-hidden="true">
            <!-- bar-chart-2 -->
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
              stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10"/>
              <line x1="12" y1="20" x2="12" y2="4"/>
              <line x1="6" y1="20" x2="6" y2="14"/>
            </svg>
          </div>
          <div class="pkg-step-body">
            <h4 class="pkg-step-title">{pkg.steps[0].title}</h4>
            <p class="pkg-step-desc">
              {pkg.steps[0].desc}
            </p>
          </div>
        </div>

        <div class="pkg-connector" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </div>

        <!-- Step 2 -->
        <div class="pkg-step reveal delay-200">
          <div class="pkg-step-icon" aria-hidden="true">
            <!-- git-compare / diff -->
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
              stroke-linejoin="round">
              <circle cx="18" cy="18" r="3"/>
              <circle cx="6" cy="6" r="3"/>
              <path d="M13 6h3a2 2 0 0 1 2 2v7"/>
              <line x1="6" y1="9" x2="6" y2="21"/>
            </svg>
          </div>
          <div class="pkg-step-body">
            <h4 class="pkg-step-title">{pkg.steps[1].title}</h4>
            <p class="pkg-step-desc">
              {pkg.steps[1].desc}
            </p>
          </div>
        </div>

        <div class="pkg-connector" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </div>

        <!-- Step 3 -->
        <div class="pkg-step reveal delay-300">
          <div class="pkg-step-icon" aria-hidden="true">
            <!-- book-open / package master -->
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
              stroke-linejoin="round">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
          </div>
          <div class="pkg-step-body">
            <h4 class="pkg-step-title">{pkg.steps[2].title}</h4>
            <p class="pkg-step-desc">
              {pkg.steps[2].desc}
            </p>
          </div>
        </div>

        <div class="pkg-connector" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </div>

        <!-- Step 4 -->
        <div class="pkg-step pkg-step--output reveal delay-300">
          <div class="pkg-step-icon pkg-step-icon--output" aria-hidden="true">
            <!-- check-circle -->
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
              stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <div class="pkg-step-body">
            <h4 class="pkg-step-title">{pkg.outputStep.title}</h4>
            <p class="pkg-step-desc">
              {pkg.outputStep.desc}
            </p>
            <div class="pkg-hitl">
              <!-- user-check -->
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
                <polyline points="16 11 18 13 22 9"/>
              </svg>
              {pkg.outputStep.hitl}
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 5 — AGENT CAPABILITIES
  ══════════════════════════════════════════════════════ -->
  <section class="fo-agents reveal">
    <div class="container">
      <p class="section-label">{agents.label}</p>
      <h2 class="section-h2">{agents.title}</h2>
      <p class="section-intro">
        {agents.intro}
      </p>

      <div class="agent-cards-grid">

        <!-- RCM Optimisation Agent -->
        <div class="agent-feature-card">
          <div class="afc-top">
            <div class="afc-icon" aria-hidden="true">
              <!-- file-check icon -->
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <path d="M9 15l2 2 4-4"/>
              </svg>
            </div>
            <span class="afc-badge">{agents.cards[0].badge}</span>
          </div>
          <p class="afc-desc">
            {agents.cards[0].desc}
          </p>
          <div class="afc-hitl">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
              <polyline points="16 11 18 13 22 9"/>
            </svg>
            {agents.cards[0].hitl}
          </div>
          <ul class="afc-capabilities">
            {agents.cards[0].capabilities.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </div>

        <!-- Package Profitability Agent -->
        <div class="agent-feature-card">
          <div class="afc-top">
            <div class="afc-icon" aria-hidden="true">
              <!-- trending-up icon -->
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                stroke-linejoin="round">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                <polyline points="17 6 23 6 23 12"/>
              </svg>
            </div>
            <span class="afc-badge">{agents.cards[1].badge}</span>
          </div>
          <p class="afc-desc">
            {agents.cards[1].desc}
          </p>
          <div class="afc-hitl">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
              <polyline points="16 11 18 13 22 9"/>
            </svg>
            {agents.cards[1].hitl}
          </div>
          <ul class="afc-capabilities">
            {agents.cards[1].capabilities.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </div>

      </div>

      <!-- ── Supply chain: adjacent domain, lighter treatment ── -->
      <div class="supply-teaser reveal">
        <div class="supply-teaser-header">
          <span class="supply-teaser-label">{agents.supply.label}</span>
          <h3 class="supply-teaser-heading">{agents.supply.heading}</h3>
          <p class="supply-teaser-intro">
            {agents.supply.intro}
          </p>
        </div>
        <div class="supply-agent-card">
          <div class="afc-top">
            <div class="afc-icon" aria-hidden="true">
              <!-- package icon -->
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                stroke-linejoin="round">
                <line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/>
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                <line x1="12" y1="22.08" x2="12" y2="12"/>
              </svg>
            </div>
            <span class="afc-badge">{agents.supply.badge}</span>
          </div>
          <p class="afc-desc">
            {agents.supply.desc}
          </p>
          <ul class="afc-capabilities">
            {agents.supply.capabilities.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 5 — OUTCOMES
  ══════════════════════════════════════════════════════ -->
  <section class="fo-outcomes reveal">
    <div class="container">
      <p class="section-label">{outcomes.label}</p>
      <h2 class="section-h2">
        {outcomes.titleLine1}<br class="br-desktop" />
        {outcomes.titleLine2}
      </h2>

      <div class="outcomes-grid">
        {outcomes.stats.map((o, i) => (
          <StatCard
            value={o.value}
            label={o.label}
            domainColor="--domain-finops"
            class={`reveal delay-${(i % 3 + 1) * 100}`}
          />
        ))}
      </div>

      <p class="outcomes-caveat">
        Indicative ranges based on the Design phase. Actual improvement is anchored in your Audit baseline.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 6 — WORKFLOW VARIANT REALITY
  ══════════════════════════════════════════════════════ -->
  <section class="fo-variants reveal">
    <div class="container">
      <p class="section-label">{variants.label}</p>
      <h2 class="section-h2">
        {variants.title}
      </h2>
      <div class="variants-prose">
        {variants.prose.map((p) => (
          <p>{p}</p>
        ))}
      </div>

      <div class="variants-table-wrap reveal delay-200">
        <WorkflowVariantTable />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 7 — FOOTER CTA
  ══════════════════════════════════════════════════════ -->
  <FooterCTA />

</Layout>

<style>
  /* ── Shared layout ── */
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .section-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--domain-finops);
    margin: 0 0 0.75rem;
  }

  .section-h2 {
    font-size: clamp(1.625rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .section-intro {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 660px;
    margin: 0 0 2.5rem;
  }

  .br-desktop { display: none; }
  @media (min-width: 768px) { .br-desktop { display: block; } }

  /* ── Section 1: Hero ── */
  .fo-hero {
    padding: 5rem 0 4rem;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4rem;
  }

  @media (max-width: 900px) {
    .hero-content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-image {
      order: -1;
    }
  }

  .domain-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--domain-finops);
    background: var(--domain-finops-muted);
    border: 1px solid var(--domain-finops-border);
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 1.25rem;
  }

  .hero-h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
  }

  .hero-h1-accent {
    color: var(--domain-finops);
  }

  .hero-sub {
    font-size: var(--text-xl);
    color: var(--text-secondary);
    font-weight: 400;
    margin: 0 0 1.25rem;
    line-height: 1.4;
  }

  .hero-body {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0 0 2rem;
    max-width: 480px;
  }

  .hero-ctas {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
  }

  .hero-image {
    position: relative;
  }

  .hero-screenshot {
    width: 100%;
    height: auto;
    border-radius: 0.875rem;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--card-shadow);
  }

  [data-theme="light"] .hero-screenshot {
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.15);
  }

  /* ── Section 2: RCM domains intro + claims lifecycle ── */
  .fo-lifecycle {
    padding: 5rem 0;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .lifecycle-diagram {
    margin-top: 0.5rem;
    border-radius: 0.875rem;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    max-width: 560px;
  }

  .lifecycle-img {
    width: 100%;
    height: auto;
    display: block;
  }

  [data-theme="light"] .lifecycle-diagram {
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  }

  .rcm-domains {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 860px) {
    .rcm-domains {
      grid-template-columns: 1fr;
    }
  }

  .rcm-domain-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-top: 3px solid var(--domain-finops);
    border-radius: 0.75rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .rcm-domain-card:hover {
    background: var(--card-bg-hover);
  }

  .rcm-domain-num {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--domain-finops);
    opacity: 0.8;
  }

  .rcm-domain-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .rcm-domain-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .rcm-divider {
    height: 1px;
    background: var(--border-subtle);
    margin: 0 0 3rem;
  }

  .rcm-sub-heading {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0 0 0.25rem;
  }

  /* ── Section 3: Payer Intelligence ── */
  .fo-payer {
    padding: 5rem 0;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .payer-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .payer-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .payer-prose {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .payer-prose p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .payer-note {
    font-style: italic;
    color: var(--domain-finops) !important;
    padding: 0.75rem 1rem;
    border-left: 2px solid var(--domain-finops-border);
    background: var(--domain-finops-muted);
    border-radius: 0 6px 6px 0;
  }

  .payer-text {
    display: flex;
    flex-direction: column;
  }

  .payer-diagram {
    position: sticky;
    top: 6rem;
  }

  /* ── Section 4: Package Profitability ── */
  .fo-pkg {
    padding: 5rem 0;
    background: var(--bg-primary);
