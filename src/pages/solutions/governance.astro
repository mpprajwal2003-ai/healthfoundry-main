---
import Layout from '../../layouts/Layout.astro';
import DomainCard from '../../components/ui/DomainCard.astro';
import ContinuousVsPeriodic from '../../components/diagrams/ContinuousVsPeriodic.astro';
import StatCard from '../../components/ui/StatCard.astro';
import FooterCTA from '../../components/sections/FooterCTA.astro';
import Button from '../../components/ui/Button.astro';
import { frontmatter } from '../../data/solutions-governance.md';

const { meta, hero, capabilities: capabilitiesData, continuousVsPeriodic, agent, outcomes: outcomesData } = frontmatter;

// ── GRC domain capability cards ──
// Icons stay here; text content comes from the data file, merged by index.
const capabilityIcons = [
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
      fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
      stroke-linejoin="round" aria-hidden="true">
      <line x1="18" y1="20" x2="18" y2="10"/>
      <line x1="12" y1="20" x2="12" y2="4"/>
      <line x1="6" y1="20" x2="6" y2="14"/>
    </svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
      fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
      stroke-linejoin="round" aria-hidden="true">
      <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
      <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
      <line x1="9" y1="12" x2="15" y2="12"/>
      <line x1="9" y1="16" x2="12" y2="16"/>
    </svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
      fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
      stroke-linejoin="round" aria-hidden="true">
      <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
      <line x1="12" y1="11" x2="12" y2="17"/>
      <line x1="9" y1="14" x2="15" y2="14"/>
    </svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
      fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
      stroke-linejoin="round" aria-hidden="true">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
    </svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
      fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
      stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/>
      <circle cx="12" cy="12" r="3"/>
      <line x1="12" y1="2" x2="12" y2="4"/>
      <line x1="12" y1="20" x2="12" y2="22"/>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
      <line x1="2" y1="12" x2="4" y2="12"/>
      <line x1="20" y1="12" x2="22" y2="12"/>
    </svg>`,
];

const capabilities = capabilitiesData.cards.map((cap, i) => ({
  ...cap,
  icon: capabilityIcons[i],
}));

// ── Outcome stat cards ──
// "Real-time vs periodic" gets special treatment (no number, split icon)
const outcomes = outcomesData.stats;
---

<Layout
  title={meta.title}
  description={meta.description}
>

  <!-- ═══════════════════════════════════════════════════
       SECTION 1 — HERO
  ══════════════════════════════════════════════════════ -->
  <section class="grc-hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-text">
          <div class="domain-pill">
            <!-- shield-check icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
            {hero.pill}
          </div>

          <h1 class="hero-h1">
            {hero.titleLine1}<br />
            <span class="hero-h1-accent">{hero.titleAccent}</span>
          </h1>

          <p class="hero-body">
            {hero.body}
          </p>

          <div class="hero-ctas">
            <Button href="/contact" variant="primary" size="lg">{hero.primaryCta}</Button>
            <Button href="/platform" variant="secondary" size="lg">{hero.secondaryCta}</Button>
          </div>
        </div>

        <div class="hero-image reveal-left delay-200">
          <img
            src="/images/grc.png"
            alt={hero.imageAlt}
            class="hero-screenshot"
            width="600"
            height="400"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 2 — WHAT WE ADDRESS (5 DomainCards)
  ══════════════════════════════════════════════════════ -->
  <section class="grc-capabilities reveal">
    <div class="container">
      <p class="section-label">{capabilitiesData.label}</p>
      <h2 class="section-h2">
        {capabilitiesData.title}
      </h2>
      <p class="section-intro">
        {capabilitiesData.intro}
      </p>

      <div class="capabilities-grid">
        {capabilities.map((cap, i) => (
          <div class={`reveal delay-${(i % 3 + 1) * 100}`}>
            <DomainCard
              icon={cap.icon}
              title={cap.title}
              description={cap.description}
              humanNote={cap.humanNote}
              domainColor="--domain-grc"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 3 — CONTINUOUS VS PERIODIC
  ══════════════════════════════════════════════════════ -->
  <section class="grc-cvp reveal">
    <div class="container">
      <div class="cvp-wrapper">
        <div class="cvp-header">
          <p class="section-label">{continuousVsPeriodic.label}</p>
          <h2 class="section-h2">
            {continuousVsPeriodic.titleLine1}<br class="br-desktop" />
            {continuousVsPeriodic.titleLine2}
          </h2>
          <p class="cvp-callout">
            {continuousVsPeriodic.callout}
          </p>
        </div>
        <div class="cvp-diagram-wrap reveal-scale delay-200">
          <ContinuousVsPeriodic />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 4 — GRC AGENT
  ══════════════════════════════════════════════════════ -->
  <section class="grc-agent reveal">
    <div class="container">
      <p class="section-label">{agent.label}</p>
      <h2 class="section-h2">{agent.title}</h2>
      <p class="section-intro">
        {agent.intro}
      </p>

      <div class="agent-card">
        <div class="agent-card-top">
          <div class="agent-icon" aria-hidden="true">
            <!-- shield-check -->
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
              stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
          </div>
          <span class="agent-name">{agent.name}</span>
        </div>

        <p class="agent-desc">
          {agent.description}
        </p>

        <div class="agent-hitl">
          <!-- user-check icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
            <polyline points="16 11 18 13 22 9"/>
          </svg>
          {agent.hitl}
        </div>

        <div class="agent-capabilities-grid">
          {agent.groups.map((group) => (
            <div class="agent-cap-group">
              <h4 class="agent-cap-heading">{group.heading}</h4>
              <ul class="agent-cap-list">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 5 — OUTCOMES
  ══════════════════════════════════════════════════════ -->
  <section class="grc-outcomes reveal">
    <div class="container">
      <p class="section-label">{outcomesData.label}</p>
      <h2 class="section-h2">{outcomesData.title}</h2>

      <div class="outcomes-grid">
        {outcomes.map((o, i) => (
          o.value !== null ? (
            <StatCard
              value={o.value}
              label={o.label}
              domainColor="--domain-grc"
              class={`reveal delay-${(i % 3 + 1) * 100}`}
            />
          ) : (
            /* Special card: Real-time vs Periodic — no percentage, split icon */
            <div class={`stat-card stat-card--special reveal delay-${(i % 3 + 1) * 100}`}>
              <div class="stat-split-visual" aria-hidden="true">
                <div class="stat-split-half stat-split-half--left">
                  <!-- clock icon (periodic) -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
                    fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                    stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                  <span class="stat-split-label">Periodic</span>
                </div>
                <div class="stat-split-arrow">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                    fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                    stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"/>
                  </svg>
                </div>
                <div class="stat-split-half stat-split-half--right">
                  <!-- zap icon (real-time) -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
                    fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                    stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                  </svg>
                  <span class="stat-split-label stat-split-label--active">Real-time</span>
                </div>
              </div>
              <div class="stat-label">{o.label}</div>
            </div>
          )
        ))}
      </div>

      <p class="outcomes-caveat">
        {outcomesData.caveat}
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 6 — FOOTER CTA
  ══════════════════════════════════════════════════════ -->
  <FooterCTA />

</Layout>

<style>
  /* ── Shared layout ── */
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .section-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--domain-grc);
    margin: 0 0 0.75rem;
  }

  .section-h2 {
    font-size: clamp(1.625rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .section-intro {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 660px;
    margin: 0 0 2.5rem;
  }

  .br-desktop { display: none; }
  @media (min-width: 768px) { .br-desktop { display: block; } }

  /* ── Section 1: Hero ── */
  .grc-hero {
    padding: 5rem 0 4rem;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4rem;
  }

  @media (max-width: 900px) {
    .hero-content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .hero-image { order: -1; }
  }

  .domain-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--domain-grc);
    background: var(--domain-grc-muted);
    border: 1px solid var(--domain-grc-border);
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 1.25rem;
  }

  .hero-h1 {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0 0 1.25rem;
  }

  .hero-h1-accent {
    color: var(--domain-grc);
    display: block;
    font-size: clamp(1.375rem, 2.8vw, 2.1rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-top: 0.25rem;
  }

  .hero-body {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0 0 2rem;
    max-width: 480px;
  }

  .hero-ctas {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
  }

  .hero-screenshot {
    width: 100%;
    height: auto;
    border-radius: 0.875rem;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--card-shadow);
  }

  [data-theme="light"] .hero-screenshot {
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.15);
  }

  /* ── Section 2: Capabilities ── */
  .grc-capabilities {
    padding: 5rem 0;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  /* 5th card (Risk Scoring) — centred in a single column on its row */
  .capabilities-grid > *:last-child {
    grid-column: 1 / -1;
    max-width: 50%;
  }

  @media (max-width: 700px) {
    .capabilities-grid {
      grid-template-columns: 1fr;
    }
    .capabilities-grid > *:last-child {
      grid-column: auto;
      max-width: none;
    }
  }

  /* ── Section 3: Continuous vs Periodic ── */
  .grc-cvp {
    padding: 5rem 0;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .cvp-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .cvp-header {
    max-width: 700px;
  }

  .cvp-callout {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .cvp-diagram-wrap {
    /* Let the diagram breathe with full width */
  }

  /* ── Section 4: GRC Agent ── */
  .grc-agent {
    padding: 5rem 0;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .agent-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-left: 3px solid var(--domain-grc);
    border-radius: 0.875rem;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 960px;
    transition: background 0.3s ease;
  }

  .agent-card:hover {
    background: var(--card-bg-hover);
  }

  .agent-card-top {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .agent-icon {
    color: var(--domain-grc);
    flex-shrink: 0;
  }

  .agent-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .agent-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
    max-width: 680px;
  }

  .agent-hitl {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--domain-grc);
    background: var(--domain-grc-muted);
    border: 1px solid var(--domain-grc-border);
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    line-height: 1.5;
    max-width: 640px;
  }

  .agent-hitl svg {
    flex-shrink: 0;
    margin-top: 1px;
  }

  .agent-capabilities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  @media (max-width: 860px) {
    .agent-capabilities-grid {
      grid-template-columns: 1fr;
    }
  }

  .agent-cap-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .agent-cap-heading {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--domain-grc);
    margin: 0;
  }

  .agent-cap-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .agent-cap-list li {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    padding-left: 1rem;
    position: relative;
    line-height: 1.5;
  }

  .agent-cap-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--domain-grc);
    font-size: 10px;
    top: 1px;
  }

  /* ── Section 5: Outcomes ── */
  .grc-outcomes {
    padding: 5rem 0;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .outcomes-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 960px) {
    .outcomes-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .outcomes-grid { grid-template-columns: 1fr; }
  }

  .outcomes-caveat {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-style: italic;
    text-align: center;
  }

  /* ── Special "Real-time vs Periodic" stat card ── */
  .stat-card--special {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    box-shadow: var(--card-shadow);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .stat-card--special:hover {
    background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
  }

  .stat-split-visual {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stat-split-half {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
  }

  .stat-split-half--left {
    color: var(--text-muted);
  }

  .stat-split-half--right {
    color: var(--domain-grc);
  }

  .stat-split-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .stat-split-label--active {
    color: var(--domain-grc);
  }

  .stat-split-arrow {
    color: var(--domain-grc);
    flex-shrink: 0;
  }

  .stat-label {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.4;
  }
</style>
