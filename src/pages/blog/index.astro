---
import Layout from '../../layouts/Layout.astro';
import FooterCTA from '../../components/sections/FooterCTA.astro';
---

<Layout
  title="Blog | HealthFoundry"
  description="Perspectives on agentic AI, healthcare operations, and the Intelligence Fabric."
>

  <!-- ═══════════════════════════════════════════════════
       SECTION 1 — HERO
  ══════════════════════════════════════════════════════ -->
  <section class="sec-hero">
    <div class="container">
      <p class="hero-label">Blog</p>
      <h1 class="hero-h1">HealthFoundry Blog</h1>
      <p class="hero-sub">
        Perspectives on agentic AI, healthcare operations, and the Intelligence Fabric.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 2 — COMING SOON
  ══════════════════════════════════════════════════════ -->
  <section class="sec-soon reveal">
    <div class="container">
      <div class="soon-card">
        <div class="soon-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/>
            <path d="M18 14h-8"/>
            <path d="M15 18h-5"/>
            <path d="M10 6h8v4h-8V6Z"/>
          </svg>
        </div>

        <div class="soon-body">
          <h2 class="soon-title">Coming soon</h2>
          <p class="soon-desc">
            We're publishing soon. In the meantime, follow us on LinkedIn for updates on
            agentic AI in healthcare, product news, and perspectives from the team.
          </p>
          <a
            href="https://linkedin.com/company/healthfoundry"
            target="_blank"
            rel="noopener noreferrer"
            class="linkedin-link"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect width="4" height="12" x="2" y="9"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
            Follow HealthFoundry on LinkedIn
          </a>
        </div>
      </div>

      <!-- Topics teaser -->
      <div class="topics-teaser reveal delay-200">
        <p class="topics-label">What we'll cover</p>
        <ul class="topics-list">
          <li class="topic-item">
            <span class="topic-dot" aria-hidden="true"></span>
            <span>Agentic AI patterns for healthcare operations — what works in production</span>
          </li>
          <li class="topic-item">
            <span class="topic-dot" aria-hidden="true"></span>
            <span>Revenue cycle optimisation: root causes and agent interventions</span>
          </li>
          <li class="topic-item">
            <span class="topic-dot" aria-hidden="true"></span>
            <span>Human-in-the-loop governance — designing for real clinical environments</span>
          </li>
          <li class="topic-item">
            <span class="topic-dot" aria-hidden="true"></span>
            <span>HL7, FHIR, and the data reality of hospital systems</span>
          </li>
          <li class="topic-item">
            <span class="topic-dot" aria-hidden="true"></span>
            <span>GRC: why continuous monitoring changes the compliance equation</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <FooterCTA />

</Layout>

<style>
  /* ── Shared ── */
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  /* ── Section 1: Hero ── */
  .sec-hero {
    padding: 5rem 0 4rem;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
    text-align: center;
  }

  .hero-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 1rem;
  }

  .hero-h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--text-primary);
    margin: 0 0 1.25rem;
  }

  .hero-sub {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 520px;
    margin: 0 auto;
  }

  /* ── Section 2: Coming Soon ── */
  .sec-soon {
    padding: 5rem 0 6rem;
    background: var(--bg-primary);
  }

  .soon-card {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    padding: 2.5rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    max-width: 680px;
    margin-bottom: 3rem;
  }

  .soon-icon {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: 14px;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .soon-body {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .soon-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .soon-desc {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .linkedin-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    border: 1px solid var(--border-default);
    border-radius: 8px;
    padding: 0.5rem 1rem;
    background: var(--bg-card);
    align-self: flex-start;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .linkedin-link:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-strong);
  }

  /* ── Topics teaser ── */
  .topics-teaser {
    max-width: 680px;
    padding: 2rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
  }

  .topics-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 1.25rem;
  }

  .topics-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .topic-item {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .topic-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--border-strong);
    flex-shrink: 0;
    position: relative;
    top: -1px;
  }

  /* ── Responsive ── */
  @media (max-width: 560px) {
    .soon-card {
      flex-direction: column;
      gap: 1.25rem;
      padding: 1.75rem;
    }
  }
</style>
