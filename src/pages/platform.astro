---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import ArchitectureLayers from '../components/diagrams/ArchitectureLayers.astro';
import AgentCard from '../components/ui/AgentCard.astro';
import HITLSpectrum from '../components/diagrams/HITLSpectrum.astro';
import MarketectureDiagram from '../components/diagrams/MarketectureDiagram.astro';
import { frontmatter } from '../data/platform.md';

const { hero, architecture, agents, hitl, deployment, aiModels, cta } = frontmatter;
---

<Layout
  title="The Intelligence Fabric | HealthFoundry Platform"
  description="HealthFoundry's Intelligence Fabric: a domain-aware agentic AI platform for healthcare operations. Semi-autonomous agents across FinOps, patient experience, and GRC — human-in-the-loop throughout."
  ogTitle="The Intelligence Fabric | HealthFoundry Platform"
  ogDescription="HealthFoundry's Intelligence Fabric: a domain-aware agentic AI platform for healthcare operations. Semi-autonomous agents across FinOps, patient experience, and GRC — human-in-the-loop throughout."
>

  <!-- =====================================================
       Section 1 — Hero
       ===================================================== -->
  <section class="platform-hero">
    <div class="container">
      <div class="hero-grid">

        <div class="hero-left">
          <p class="section-label">{hero.label}</p>
          <h1 class="hero-title">
            {hero.title}
            <span class="hero-title-sub">{hero.titleSub}</span>
          </h1>
          <p class="hero-sub">
            {hero.subtitle}
          </p>
          <div class="hero-ctas">
            <Button href="/contact" variant="primary" size="lg">{hero.ctaPrimary}</Button>
            <Button href="#architecture" variant="secondary" size="lg">{hero.ctaSecondary}</Button>
          </div>
        </div>

        <div class="hero-right">
          <MarketectureDiagram />
        </div>

      </div>
    </div>
  </section>

  <!-- =====================================================
       Section 2 — Architecture Overview
       ===================================================== -->
  <section class="arch-section section-padding reveal" id="architecture">
    <div class="container">
      <p class="section-label">{architecture.label}</p>
      <h2 class="section-title">{architecture.title}</h2>
      <p class="section-intro">
        {architecture.intro}
      </p>
      <ArchitectureLayers />
    </div>
  </section>

  <!-- =====================================================
       Section 3 — Agent Grid
       ===================================================== -->
  <section class="agents-section section-padding reveal">
    <div class="container">
      <p class="section-label">{agents.label}</p>
      <h2 class="section-title">{agents.title}</h2>
      <p class="section-intro">
        {agents.intro}
      </p>

      <div class="agents-grid">
        {agents.items.map((agent) => (
          <AgentCard
            agentName={agent.name}
            domain={agent.domain}
            description={agent.description}
            capabilityTag={agent.capabilityTag}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================
       Section 4 — HITL Governance
       ===================================================== -->
  <section class="hitl-section section-padding reveal">
    <div class="container">
      <p class="section-label">{hitl.label}</p>
      <h2 class="section-title">{hitl.title}</h2>

      <p class="section-intro">
        {hitl.intro}
      </p>

      <div class="hitl-categories">
        {hitl.categories.map((cat) => (
          <div class="hitl-cat">
            <div class="hitl-cat-num">{cat.num}</div>
            <h3 class="hitl-cat-title">{cat.title}</h3>
            <p class="hitl-cat-body">
              {cat.body}
            </p>
          </div>
        ))}
      </div>

      <div class="hitl-spectrum-wrap">
        <HITLSpectrum />
      </div>

      <p class="hitl-result">
        {hitl.result}
      </p>
    </div>
  </section>

  <!-- =====================================================
       Section 5 — Deployment Options
       ===================================================== -->
  <section class="deploy-section section-padding reveal">
    <div class="container">
      <p class="section-label">{deployment.label}</p>
      <h2 class="section-title">{deployment.title}</h2>

      <div class="deploy-grid">

        <div class="deploy-card">
          <div class="deploy-icon">
            <!-- server icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="8" x="2" y="2" rx="2" ry="2"/>
              <rect width="20" height="8" x="2" y="14" rx="2" ry="2"/>
              <line x1="6" x2="6.01" y1="6" y2="6"/>
              <line x1="6" x2="6.01" y1="18" y2="18"/>
            </svg>
          </div>
          <h3 class="deploy-title">{deployment.cards[0].title}</h3>
          <p class="deploy-desc">
            {deployment.cards[0].description}
          </p>
        </div>

        <div class="deploy-card">
          <div class="deploy-icon">
            <!-- cloud icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>
            </svg>
          </div>
          <h3 class="deploy-title">{deployment.cards[1].title}</h3>
          <p class="deploy-desc">
            {deployment.cards[1].description}
          </p>
        </div>

        <div class="deploy-card">
          <div class="deploy-icon">
            <!-- layers icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <polygon points="12 2 2 7 12 12 22 7 12 2"/>
              <polyline points="2 17 12 22 22 17"/>
              <polyline points="2 12 12 17 22 12"/>
            </svg>
          </div>
          <h3 class="deploy-title">{deployment.cards[2].title}</h3>
          <p class="deploy-desc">
            {deployment.cards[2].description}
          </p>
        </div>

        <div class="deploy-card">
          <div class="deploy-icon">
            <!-- shield-check icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
          <h3 class="deploy-title">{deployment.cards[3].title}</h3>
          <p class="deploy-desc">
            {deployment.cards[3].description}
          </p>
        </div>

      </div>

      <p class="deploy-note">
        {deployment.note}
      </p>
    </div>
  </section>

  <!-- =====================================================
       Section 6 — AI Models
       ===================================================== -->
  <section class="models-section section-padding reveal">
    <div class="container">
      <p class="section-label">{aiModels.label}</p>
      <h2 class="section-title">{aiModels.title}</h2>
      <p class="section-intro">
        {aiModels.intro}
      </p>

      <div class="models-grid">

        <div class="model-card">
          <div class="model-icon">
            <!-- brain / cpu icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <rect width="16" height="16" x="4" y="4" rx="2"/>
              <rect width="6" height="6" x="9" y="9" rx="1"/>
              <path d="M15 2v2M15 20v2M2 15h2M20 15h2M2 9h2M20 9h2M9 2v2M9 20v2"/>
            </svg>
          </div>
          <h3 class="model-title">{aiModels.cards[0].title}</h3>
          <p class="model-desc">
            {aiModels.cards[0].description}
          </p>
          <div class="model-tags">
            {aiModels.cards[0].tags.map((tag) => <span class="model-tag">{tag}</span>)}
          </div>
        </div>

        <div class="model-card">
          <div class="model-icon">
            <!-- activity icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
          </div>
          <h3 class="model-title">{aiModels.cards[1].title}</h3>
          <p class="model-desc">
            {aiModels.cards[1].description}
          </p>
          <div class="model-tags">
            {aiModels.cards[1].tags.map((tag) => <span class="model-tag">{tag}</span>)}
          </div>
        </div>

        <div class="model-card">
          <div class="model-icon">
            <!-- settings / sliders icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <line x1="4" x2="4" y1="21" y2="14"/>
              <line x1="4" x2="4" y1="10" y2="3"/>
              <line x1="12" x2="12" y1="21" y2="12"/>
              <line x1="12" x2="12" y1="8" y2="3"/>
              <line x1="20" x2="20" y1="21" y2="16"/>
              <line x1="20" x2="20" y1="12" y2="3"/>
              <line x1="1" x2="7" y1="14" y2="14"/>
              <line x1="9" x2="15" y1="8" y2="8"/>
              <line x1="17" x2="23" y1="16" y2="16"/>
            </svg>
          </div>
          <h3 class="model-title">{aiModels.cards[2].title}</h3>
          <p class="model-desc">
            {aiModels.cards[2].description}
          </p>
          <div class="model-tags">
            {aiModels.cards[2].tags.map((tag) => <span class="model-tag">{tag}</span>)}
          </div>
        </div>

        <div class="model-card">
          <div class="model-icon">
            <!-- refresh-cw icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
              <path d="M21 3v5h-5"/>
              <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
              <path d="M8 16H3v5"/>
            </svg>
          </div>
          <h3 class="model-title">{aiModels.cards[3].title}</h3>
          <p class="model-desc">
            {aiModels.cards[3].description}
          </p>
          <div class="model-tags">
            {aiModels.cards[3].tags.map((tag) => <span class="model-tag">{tag}</span>)}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- =====================================================
       Section 7 — CTA
       ===================================================== -->
  <section class="platform-cta reveal">
    <div class="container">
      <h2 class="cta-headline">{cta.headline}</h2>
      <p class="cta-sub">
        {cta.subtitle}
      </p>
      <Button href="/contact" variant="primary" size="lg">{cta.button}</Button>
    </div>
  </section>

</Layout>

<style>
  /* ---- Shared layout ---- */
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .section-padding {
    padding: 5rem 0;
  }

  .section-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--section-label-color);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
    max-width: 680px;
  }

  .section-intro {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 700px;
    margin: 0 0 2.5rem;
  }

  /* ---- Hero ---- */
  .platform-hero {
    background: var(--bg-primary);
    padding: 5rem 0 4rem;
    overflow: hidden;
    position: relative;
  }

  .platform-hero::before {
    content: '';
    position: absolute;
    top: -150px;
    right: -150px;
    width: 500px;
    height: 500px;
    background: radial-gradient(ellipse, var(--accent-glow-soft) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--hero-title-color);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .hero-title-sub {
    font-size: clamp(1rem, 2vw, 1.375rem);
    font-weight: 400;
    color: var(--text-secondary);
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  .hero-sub {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0;
    max-width: 520px;
  }

  .hero-ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .hero-right {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ---- Architecture ---- */
  .arch-section {
    background: var(--bg-secondary);
  }

  /* ---- Agents ---- */
  .agents-section {
    background: var(--bg-primary);
  }

  .agents-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  /* ---- HITL Governance ---- */
  .hitl-section {
    background: var(--bg-tertiary);
  }

  .hitl-categories {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .hitl-cat {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
  }

  .hitl-cat-num {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .hitl-cat-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.35;
  }

  .hitl-cat-body {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .hitl-spectrum-wrap {
    margin-bottom: 1.5rem;
  }

  .hitl-result {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.75;
    border-left: 2px solid var(--border-default);
    padding-left: 1.25rem;
    margin: 0;
    max-width: 680px;
  }

  /* ---- Deployment ---- */
  .deploy-section {
    background: var(--bg-secondary);
  }

  .deploy-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .deploy-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .deploy-card:hover {
    background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
  }

  .deploy-icon {
    color: var(--accent-primary);
    opacity: 0.7;
    width: 44px;
    height: 44px;
    background: var(--bg-highlight);
    border: 1px solid var(--border-subtle);
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .deploy-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .deploy-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .deploy-note {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.75;
    border-left: 2px solid var(--border-default);
    padding-left: 1.25rem;
    margin: 0;
    max-width: 680px;
  }

  /* ---- AI Models ---- */
  .models-section {
    background: var(--bg-primary);
  }

  .models-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .model-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .model-card:hover {
    background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
  }

  .model-icon {
    color: var(--accent-primary);
    opacity: 0.7;
  }

  .model-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .model-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
    flex: 1;
  }

  .model-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
  }

  .model-tag {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--bg-highlight);
    border: 1px solid var(--border-subtle);
    border-radius: 9999px;
    padding: 0.2rem 0.625rem;
  }

  /* ---- CTA ---- */
  .platform-cta {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-subtle);
    padding: 5rem 0;
    text-align: center;
  }

  .platform-cta .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .cta-headline {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 640px;
  }

  .cta-sub {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 560px;
    margin: 0 0 0.5rem;
  }

  /* ---- Responsive ---- */
  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero-right {
      order: -1;
    }
  }

  @media (max-width: 768px) {
    .platform-hero {
      padding: 3rem 0;
    }

    .agents-grid,
    .hitl-categories,
    .deploy-grid,
    .models-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
