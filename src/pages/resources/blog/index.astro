---
import Layout from '../../../layouts/Layout.astro';
import FooterCTA from '../../../components/sections/FooterCTA.astro';
import { frontmatter } from '../../../data/blog.md';

const { hero, posts } = frontmatter;
---

<Layout
  title="Resources & Insights | HealthFoundry"
  description="Thoughts on the future of healthcare technology — agentic AI, healthcare operations, and the Intelligence Fabric."
>

  <!-- ═══════════════════════════════════════════════════
       SECTION 1 — HERO
  ══════════════════════════════════════════════════════ -->
  <section class="sec-hero">
    <div class="container">
      <p class="hero-label">Resources</p>
      <h1 class="hero-h1">{hero.title}</h1>
      <p class="hero-sub">{hero.intro}</p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 2 — POST GRID
  ══════════════════════════════════════════════════════ -->
  <section class="sec-posts reveal">
    <div class="container">
      <div class="post-grid">
        {posts.map((post) => (
          <a href={`/resources/blog/${post.slug}`} class="post-card">
            <div class="post-body">
              <span class="post-category">{post.category}</span>
              <h2 class="post-title">{post.title}</h2>
              <p class="post-excerpt">{post.excerpt}</p>
            </div>
            <div class="post-footer">
              <span class="post-date">{post.date}</span>
              <span class="post-read">
                Read
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FooterCTA />

</Layout>

<style>
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  /* ── Hero ── */
  .sec-hero {
    padding: 5rem 0 4rem;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
    text-align: center;
  }

  .hero-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 1rem;
  }

  .hero-h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--text-primary);
    margin: 0 0 1.25rem;
  }

  .hero-sub {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 520px;
    margin: 0 auto;
  }

  /* ── Posts ── */
  .sec-posts {
    padding: 5rem 0 6rem;
    background: var(--bg-primary);
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.75rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    text-decoration: none;
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
  }

  .post-card:hover {
    background: var(--card-bg-hover);
    border-color: var(--card-border-hover);
    transform: translateY(-2px);
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .post-category {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--domain-cx);
  }

  .post-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .post-excerpt {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .post-date {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .post-read {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    transition: gap 0.2s ease;
  }

  .post-card:hover .post-read {
    gap: 0.625rem;
  }

  @media (max-width: 900px) {
    .post-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
