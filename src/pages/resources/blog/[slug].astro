---
import Layout from '../../../layouts/Layout.astro';
import FooterCTA from '../../../components/sections/FooterCTA.astro';
import { frontmatter } from '../../../data/blog.md';

export function getStaticPaths() {
  return frontmatter.posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<Layout
  title={`${post.title} | HealthFoundry`}
  description={post.excerpt}
>

  <article class="sec-article">
    <div class="container">
      <a href="/resources/blog" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Back to Resources
      </a>

      <div class="article-meta">
        <span class="article-category">{post.category}</span>
        <span class="article-date">{post.date}</span>
      </div>

      <h1 class="article-title">{post.title}</h1>

      <div class="article-content" set:html={post.content} />
    </div>
  </article>

  <FooterCTA />

</Layout>

<style>
  .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .sec-article {
    padding: 5rem 0 4rem;
    background: var(--bg-primary);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 2.5rem;
    transition: color 0.2s ease, gap 0.2s ease;
  }

  .back-link:hover {
    color: var(--text-primary);
    gap: 0.75rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .article-category {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--domain-cx);
  }

  .article-date {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .article-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--text-primary);
    margin: 0 0 2rem;
  }

  .article-content :global(p) {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.8;
    margin: 0 0 1.25rem;
  }
</style>
