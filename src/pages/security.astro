---
import Layout from '../layouts/Layout.astro';
import DomainCard from '../components/ui/DomainCard.astro';
import DeploymentTopology from '../components/diagrams/DeploymentTopology.astro';
import FooterCTA from '../components/sections/FooterCTA.astro';
import Button from '../components/ui/Button.astro';

// ── Icon SVG strings ──────────────────────────────────────────────────

const iconShield = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
  fill="none" stroke="currentColor" stroke-width="1.8"
  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
</svg>`;

const iconCheckCircle = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
  fill="none" stroke="currentColor" stroke-width="1.8"
  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
  <polyline points="22 4 12 14.01 9 11.01"/>
</svg>`;

const iconScale = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
  fill="none" stroke="currentColor" stroke-width="1.8"
  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
  <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
  <path d="M7 21h10"/>
  <path d="M12 3v18"/>
  <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
</svg>`;

const iconLayers = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
  fill="none" stroke="currentColor" stroke-width="1.8"
  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <polygon points="12 2 2 7 12 12 22 7 12 2"/>
  <polyline points="2 17 12 22 22 17"/>
  <polyline points="2 12 12 17 22 12"/>
</svg>`;

const iconLock = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
  fill="none" stroke="currentColor" stroke-width="1.8"
  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
</svg>`;

const iconServer = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
  fill="none" stroke="currentColor" stroke-width="1.8"
  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <rect width="20" height="8" x="2" y="2" rx="2" ry="2"/>
  <rect width="20" height="8" x="2" y="14" rx="2" ry="2"/>
  <line x1="6" x2="6.01" y1="6" y2="6"/>
  <line x1="6" x2="6.01" y1="18" y2="18"/>
</svg>`;

import { frontmatter } from '../data/security.md';

// Map data icon keys → SVG string constants above
const iconMap = {
  Lock: iconLock,
  LayoutTemplate: iconLayers,
  Gavel: iconScale,
  ShieldCheck: iconShield,
  Database: iconServer,
};
const securityItems = frontmatter.items.map((item) => ({
  ...item,
  iconSvg: iconMap[item.icon] ?? iconShield,
}));
---

<Layout
  title={frontmatter.meta.title}
  description={frontmatter.meta.description}
>

  <!-- ═══════════════════════════════════════════════════
       SECTION 1 — HERO
  ══════════════════════════════════════════════════════ -->
  <section class="sec-hero">
    <div class="container">
      <div class="hero-content">
        <p class="hero-eyebrow">{frontmatter.hero.eyebrow}</p>
        <h1 class="hero-h1">{frontmatter.hero.title}</h1>
        <p class="hero-sub">
          {frontmatter.hero.subtitle}
        </p>
        <div class="hero-ctas">
          <Button href={frontmatter.hero.primaryCta.href} variant="primary" size="lg">{frontmatter.hero.primaryCta.label}</Button>
          <Button href={frontmatter.hero.secondaryCta.href} variant="secondary" size="lg">{frontmatter.hero.secondaryCta.label}</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 2 — COMPLIANCE & CERTIFICATION CARDS
  ══════════════════════════════════════════════════════ -->
  <section class="sec-cards reveal">
    <div class="container">
      <div class="cards-header">
        <p class="section-label">{frontmatter.cards.label}</p>
        <h2 class="section-h2">{frontmatter.cards.title}</h2>
        <p class="section-intro">
          {frontmatter.cards.intro}
        </p>
      </div>

      <div class="cards-grid">
        {securityItems.map((item, i) => (
          <div class={`reveal delay-${((i % 3) + 1) * 100}`}>
            <DomainCard
              icon={item.iconSvg}
              title={item.title}
              description={item.desc}
              domainColor="--domain-grc"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 3 — DEPLOYMENT TOPOLOGY
  ══════════════════════════════════════════════════════ -->
  <section class="sec-topology reveal">
    <div class="container">
      <div class="topology-layout">

        <div class="topology-text">
          <p class="section-label">{frontmatter.topology.label}</p>
          <h2 class="section-h2">{frontmatter.topology.title}</h2>
          <div class="topology-prose">
            {frontmatter.topology.prose.map((para) => (
              <p>{para}</p>
            ))}
          </div>

          <div class="topology-facts">
            {frontmatter.topology.facts.map((fact) => (
              <div class="topo-fact">
                <div class="topo-fact-icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                    fill="none" stroke="currentColor" stroke-width="2.5"
                    stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </div>
                <span>{fact}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="topology-diagram reveal-scale delay-200">
          <p class="visual-label">{frontmatter.topology.visualLabel}</p>
          <DeploymentTopology />
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 4 — SECURITY CTA
  ══════════════════════════════════════════════════════ -->
  <section class="sec-cta reveal">
    <div class="container">
      <div class="cta-inner">
        <div class="cta-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <h2 class="cta-headline">{frontmatter.cta.headline}</h2>
        <p class="cta-sub">
          {frontmatter.cta.subtitle}
        </p>
        <Button href={frontmatter.cta.buttonHref} variant="primary" size="lg">
          {frontmatter.cta.buttonLabel}
        </Button>
      </div>
    </div>
  </section>

  <FooterCTA />

</Layout>

<style>
  /* ── Shared ── */
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .section-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.5rem;
  }

  .section-h2 {
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .br-desktop { display: none; }
  @media (min-width: 768px) { .br-desktop { display: block; } }

  /* ── Section 1: Hero ── */
  .sec-hero {
    padding: 6rem 0 5rem;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
    text-align: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .hero-eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--domain-grc);
    margin: 0;
  }

  .hero-h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--text-primary);
    margin: 0;
  }

  .hero-sub {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 620px;
    margin: 0;
  }

  .hero-ctas {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ── Section 2: Cards ── */
  .sec-cards {
    padding: 5rem 0;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .cards-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-intro {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Section 3: Topology ── */
  .sec-topology {
    padding: 5rem 0;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .topology-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .topology-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  .topology-prose {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-bottom: 1.5rem;
  }

  .topology-prose p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .topology-facts {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .topo-fact {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .topo-fact-icon {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--domain-grc);
    display: flex;
    align-items: center;
  }

  .topology-diagram {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .visual-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0;
  }

  /* ── Section 4: Security CTA ── */
  .sec-cta {
    padding: 5rem 0;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    max-width: 640px;
    margin: 0 auto;
  }

  .cta-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--domain-grc) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--domain-grc) 25%, transparent);
    border-radius: 12px;
    color: var(--domain-grc);
  }

  .cta-headline {
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .cta-sub {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0 0 0.5rem;
  }
</style>
