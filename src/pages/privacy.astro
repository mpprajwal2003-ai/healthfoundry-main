---
import Layout from '../layouts/Layout.astro';
import { frontmatter } from '../data/privacy.md';

const { meta, label, title, lastUpdated, sections, note } = frontmatter;
---

<Layout
  title={meta.title}
  description={meta.description}
>
  <section class="privacy-section">
    <div class="container">
      <p class="section-label">{label}</p>
      <h1 class="privacy-title">{title}</h1>
      <p class="privacy-meta">{lastUpdated}</p>

      <div class="privacy-body">
        {sections.map((section) => (
          <>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((p) => <p set:html={p} />)}
          </>
        ))}

        <p class="privacy-note">
          {note}
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .privacy-section {
    padding-top: 5rem;
    padding-bottom: 6rem;
  }

  .section-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--section-label-color);
    margin-bottom: 1rem;
  }

  .privacy-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .privacy-meta {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: 3rem;
  }

  .privacy-body {
    max-width: 680px;
  }

  .privacy-body h2 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 2.5rem 0 0.75rem;
  }

  .privacy-body h2:first-child {
    margin-top: 0;
  }

  .privacy-body p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0 0 1rem;
  }

  .privacy-body a {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .privacy-body a:hover {
    color: var(--text-secondary);
  }

  .privacy-note {
    margin-top: 3rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: 10px;
    font-size: var(--text-sm) !important;
    color: var(--text-muted) !important;
    font-style: italic;
  }
</style>
