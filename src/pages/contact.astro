---
import Layout from '../layouts/Layout.astro';
import FooterCTA from '../components/sections/FooterCTA.astro';
import Button from '../components/ui/Button.astro';
import { frontmatter } from '../data/contact.md';

const { meta, hero, form, side } = frontmatter;
---

<Layout
  title={meta.title}
  description={meta.description}
>

  <!-- ═══════════════════════════════════════════════════
       SECTION 1 — HERO
  ══════════════════════════════════════════════════════ -->
  <section class="sec-hero">
    <div class="container">
      <p class="hero-label">{hero.label}</p>
      <h1 class="hero-h1">{hero.title}</h1>
      <p class="hero-sub">
        {hero.subtitle}
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 2 — FORM + SIDE PANEL
  ══════════════════════════════════════════════════════ -->
  <section class="sec-contact reveal">
    <div class="container">
      <div class="contact-layout">

        <!-- Contact Form -->
        <div class="form-panel">
          <form
            id="contact-form"
            class="contact-form"
            novalidate
          >
            {form.fields.map((field) => (
              <div class="form-group">
                <label for={field.id} class="form-label">{field.label} <span class="required" aria-hidden="true">*</span></label>
                <input
                  type={field.type}
                  id={field.id}
                  name={field.id}
                  class="form-input"
                  placeholder={field.placeholder}
                  required={field.required}
                  autocomplete={field.autocomplete}
                />
              </div>
            ))}

            <div class="form-group">
              <label for={form.message.id} class="form-label">
                {form.message.label} <span class="optional">{form.message.optionalText}</span>
              </label>
              <textarea
                id={form.message.id}
                name={form.message.id}
                class="form-input form-textarea"
                rows="4"
                placeholder={form.message.placeholder}
              ></textarea>
            </div>

            <Button type="submit" variant="primary" size="lg" class="form-submit">
              {form.submitLabel}
            </Button>

            <p class="form-status" id="form-status" role="status" aria-live="polite" hidden></p>

            <p class="form-note">
              {form.note}
            </p>
          </form>
        </div>

        <!-- Side Panel -->
        <aside class="side-panel reveal delay-200">
          <div class="side-card">
            <p class="side-label">{side.contactLabel}</p>

            <div class="side-item">
              <div class="side-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round" aria-hidden="true">
                  <rect width="20" height="16" x="2" y="4" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              </div>
              <div class="side-detail">
                <p class="side-detail-label">{side.email.label}</p>
                <a href={side.email.link} class="side-link">
                  {side.email.address}
                </a>
              </div>
            </div>

            <div class="side-item">
              <div class="side-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round" aria-hidden="true">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                  <rect width="4" height="12" x="2" y="9"/>
                  <circle cx="4" cy="4" r="2"/>
                </svg>
              </div>
              <div class="side-detail">
                <p class="side-detail-label">{side.linkedin.label}</p>
                <a
                  href={side.linkedin.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="side-link"
                >
                  {side.linkedin.text}
                </a>
              </div>
            </div>

            
          </div>

          <div class="side-card side-card-what">
            <p class="side-label">{side.expect.label}</p>
            <ol class="expect-list">
              {side.expect.items.map((item, i) => (
                <li class="expect-item">
                  <span class="expect-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="expect-text">
                    {item}
                  </span>
                </li>
              ))}
            </ol>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <!-- <FooterCTA /> -->

</Layout>

<script>
  const SCRIPT_URL = import.meta.env.PUBLIC_CONTACT_SCRIPT_URL;

  // Personal / free email providers that are NOT allowed — work email only.
  const BLOCKED_DOMAINS = new Set([
    'gmail.com', 'googlemail.com', 'yahoo.com', 'yahoo.co.in', 'ymail.com',
    'hotmail.com', 'outlook.com', 'live.com', 'msn.com', 'aol.com',
    'icloud.com', 'me.com', 'mac.com', 'protonmail.com', 'proton.me',
    'mail.com', 'gmx.com', 'zoho.com', 'yandex.com', 'rediffmail.com',
    'rocketmail.com', 'tutanota.com', 'pm.me',
  ]);

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status') as HTMLParagraphElement | null;
  const emailInput = document.getElementById('email') as HTMLInputElement | null;

  const EMAIL_RE = /^[^\s@]+@([^\s@]+\.[^\s@]+)$/;

  function validationError(email: string): string | null {
    const match = email.trim().toLowerCase().match(EMAIL_RE);
    if (!match) return 'Please enter a valid email address.';
    const domain = match[1];
    if (BLOCKED_DOMAINS.has(domain)) {
      return 'Please use your work email — personal email addresses are not accepted.';
    }
    return null;
  }

  function setStatus(message: string, type: 'error' | 'success' | 'pending') {
    if (!status) return;
    status.textContent = message;
    status.hidden = false;
    status.dataset.type = type;
  }

  // Live feedback on the email field.
  emailInput?.addEventListener('input', () => {
    const err = emailInput.value ? validationError(emailInput.value) : null;
    emailInput.setCustomValidity(err ?? '');
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!SCRIPT_URL) {
      setStatus('Form is not configured. Please email hello@healthfoundry.ai directly.', 'error');
      return;
    }

    const data = new FormData(form);
    const email = String(data.get('email') ?? '');

    const emailErr = validationError(email);
    if (emailErr) {
      setStatus(emailErr, 'error');
      emailInput?.focus();
      return;
    }

    const submitBtn = form.querySelector<HTMLButtonElement>('[type="submit"]');
    if (submitBtn) submitBtn.disabled = true;
    setStatus('Sending…', 'pending');

    // Shape the payload to match the Apps Script (JSON; `company` field).
    const payload = {
      name: String(data.get('name') ?? ''),
      email,
      company: String(data.get('organisation') ?? ''),
      message: String(data.get('message') ?? ''),
    };

    try {
      // Apps Script web apps don't return CORS headers, so use no-cors.
      // text/plain keeps the request "simple" (no preflight) while the body
      // is still JSON that doPost parses via JSON.parse(e.postData.contents).
      await fetch(SCRIPT_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(payload),
      });
      form.reset();
      setStatus("Thanks — your message has been sent. We'll respond within one business day.", 'success');
    } catch (err) {
      setStatus('Something went wrong. Please email hello@healthfoundry.ai directly.', 'error');
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>

<style>
  /* ── Shared ── */
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  /* ── Section 1: Hero ── */
  .sec-hero {
    padding: 5rem 0 3rem;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
    text-align: center;
  }

  .hero-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 1rem;
  }

  .hero-h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--text-primary);
    margin: 0 0 1.25rem;
  }

  .hero-sub {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 580px;
    margin: 0 auto;
  }

  /* ── Section 2: Contact layout ── */
  .sec-contact {
    padding: 4rem 0 5rem;
    background: var(--bg-primary);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 4rem;
    align-items: start;
  }

  /* ── Form Panel ── */
  .form-panel {
    min-width: 0;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .required {
    color: var(--domain-cx);
    margin-left: 0.125rem;
  }

  .optional {
    font-weight: 400;
    color: var(--text-muted);
    font-size: var(--text-xs);
    letter-spacing: 0;
    text-transform: none;
  }

  .form-input {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: var(--text-base);
    color: var(--text-primary);
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    width: 100%;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-input::placeholder {
    color: var(--text-muted);
  }

  .form-input:focus {
    border-color: var(--border-strong);
    box-shadow: 0 0 0 3px var(--accent-glow-soft);
  }

  .form-input:invalid:not(:placeholder-shown) {
    border-color: rgba(239, 68, 68, 0.5);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.6;
  }

  .form-submit {
    align-self: flex-start;
  }

  .form-note {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .form-status {
    font-size: var(--text-sm);
    margin: 0;
    line-height: 1.5;
  }

  .form-status[data-type="error"] {
    color: #ef4444;
  }

  .form-status[data-type="success"] {
    color: var(--accent-primary);
  }

  .form-status[data-type="pending"] {
    color: var(--text-secondary);
  }

  /* ── Side Panel ── */
  .side-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .side-card {
    padding: 1.75rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
  }

  .side-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 1.25rem;
  }

  .side-item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .side-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .side-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    color: var(--text-secondary);
    flex-shrink: 0;
  }

  .side-detail {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .side-detail-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0;
  }

  .side-link {
    font-size: var(--text-sm);
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
  }

  .side-link:hover {
    text-decoration: underline;
    color: var(--accent-primary);
  }

  .side-address {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* ── What to expect ── */
  .expect-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .expect-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .expect-num {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    flex-shrink: 0;
    padding-top: 0.1rem;
    min-width: 1.75rem;
  }

  .expect-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .side-panel {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .side-card {
      flex: 1;
      min-width: 260px;
    }
  }

  @media (max-width: 560px) {
    .side-panel {
      flex-direction: column;
    }

    .form-submit {
      width: 100%;
    }
  }
</style>
