---
import Layout from '../layouts/Layout.astro';
import FooterCTA from '../components/sections/FooterCTA.astro';
import Button from '../components/ui/Button.astro';
---

<Layout
  title="Book a Discovery Call | HealthFoundry"
  description="Start with a structured discovery session — we map your operations, validate your KPIs, and show you where AI agents can move the needle first."
>

  <!-- ═══════════════════════════════════════════════════
       SECTION 1 — HERO
  ══════════════════════════════════════════════════════ -->
  <section class="sec-hero">
    <div class="container">
      <p class="hero-label">Contact</p>
      <h1 class="hero-h1">Book a Discovery Call</h1>
      <p class="hero-sub">
        Start with a structured discovery session — we map your operations, validate your KPIs,
        and show you where AI agents can move the needle first.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       SECTION 2 — FORM + SIDE PANEL
  ══════════════════════════════════════════════════════ -->
  <section class="sec-contact reveal">
    <div class="container">
      <div class="contact-layout">

        <!-- Contact Form -->
        <div class="form-panel">
          <!-- TODO: wire up form action to backend handler -->
          <form
            action="/contact-success"
            method="POST"
            class="contact-form"
            novalidate
          >
            <div class="form-group">
              <label for="name" class="form-label">Full name <span class="required" aria-hidden="true">*</span></label>
              <input
                type="text"
                id="name"
                name="name"
                class="form-input"
                placeholder="Dr. Priya Sharma"
                required
                autocomplete="name"
              />
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Work email <span class="required" aria-hidden="true">*</span></label>
              <input
                type="email"
                id="email"
                name="email"
                class="form-input"
                placeholder="priya@hospital.org"
                required
                autocomplete="email"
              />
            </div>

            <div class="form-group">
              <label for="organisation" class="form-label">Organisation <span class="required" aria-hidden="true">*</span></label>
              <input
                type="text"
                id="organisation"
                name="organisation"
                class="form-input"
                placeholder="City General Hospital"
                required
                autocomplete="organization"
              />
            </div>

            <div class="form-group">
              <label for="message" class="form-label">
                Notes <span class="optional">(optional)</span>
              </label>
              <textarea
                id="message"
                name="message"
                class="form-input form-textarea"
                rows="4"
                placeholder="Tell us about your biggest operational challenge — revenue cycle, patient experience, compliance, or something else."
              ></textarea>
            </div>

            <Button type="submit" variant="primary" size="lg" class="form-submit">
              Send Message
            </Button>

            <p class="form-note">
              We typically respond within one business day.
            </p>
          </form>
        </div>

        <!-- Side Panel -->
        <aside class="side-panel reveal delay-200">
          <div class="side-card">
            <p class="side-label">Get in touch directly</p>

            <div class="side-item">
              <div class="side-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round" aria-hidden="true">
                  <rect width="20" height="16" x="2" y="4" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              </div>
              <div class="side-detail">
                <p class="side-detail-label">Email</p>
                <a href="mailto:hello@healthfoundry.ai" class="side-link">
                  hello@healthfoundry.ai
                </a>
              </div>
            </div>

            <div class="side-item">
              <div class="side-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round" aria-hidden="true">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                  <rect width="4" height="12" x="2" y="9"/>
                  <circle cx="4" cy="4" r="2"/>
                </svg>
              </div>
              <div class="side-detail">
                <p class="side-detail-label">LinkedIn</p>
                <a
                  href="https://linkedin.com/company/healthfoundry"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="side-link"
                >
                  HealthFoundry
                </a>
              </div>
            </div>
          </div>

          <div class="side-card side-card-what">
            <p class="side-label">What to expect</p>
            <ol class="expect-list">
              <li class="expect-item">
                <span class="expect-num" aria-hidden="true">01</span>
                <span class="expect-text">
                  A 45–60 minute structured session to map your current operations
                </span>
              </li>
              <li class="expect-item">
                <span class="expect-num" aria-hidden="true">02</span>
                <span class="expect-text">
                  Validation of your current KPIs and identification of the highest-impact gaps
                </span>
              </li>
              <li class="expect-item">
                <span class="expect-num" aria-hidden="true">03</span>
                <span class="expect-text">
                  A clear picture of where agents can be deployed first for fastest measurable impact
                </span>
              </li>
            </ol>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <FooterCTA />

</Layout>

<style>
  /* ── Shared ── */
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  /* ── Section 1: Hero ── */
  .sec-hero {
    padding: 5rem 0 3rem;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
    text-align: center;
  }

  .hero-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 1rem;
  }

  .hero-h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--text-primary);
    margin: 0 0 1.25rem;
  }

  .hero-sub {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 580px;
    margin: 0 auto;
  }

  /* ── Section 2: Contact layout ── */
  .sec-contact {
    padding: 4rem 0 5rem;
    background: var(--bg-primary);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 4rem;
    align-items: start;
  }

  /* ── Form Panel ── */
  .form-panel {
    min-width: 0;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .required {
    color: var(--domain-cx);
    margin-left: 0.125rem;
  }

  .optional {
    font-weight: 400;
    color: var(--text-muted);
    font-size: var(--text-xs);
    letter-spacing: 0;
    text-transform: none;
  }

  .form-input {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: var(--text-base);
    color: var(--text-primary);
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    width: 100%;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-input::placeholder {
    color: var(--text-muted);
  }

  .form-input:focus {
    border-color: var(--border-strong);
    box-shadow: 0 0 0 3px var(--accent-glow-soft);
  }

  .form-input:invalid:not(:placeholder-shown) {
    border-color: rgba(239, 68, 68, 0.5);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.6;
  }

  .form-submit {
    align-self: flex-start;
  }

  .form-note {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* ── Side Panel ── */
  .side-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .side-card {
    padding: 1.75rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
  }

  .side-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 1.25rem;
  }

  .side-item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .side-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .side-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    color: var(--text-secondary);
    flex-shrink: 0;
  }

  .side-detail {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .side-detail-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0;
  }

  .side-link {
    font-size: var(--text-sm);
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
  }

  .side-link:hover {
    text-decoration: underline;
    color: var(--accent-primary);
  }

  /* ── What to expect ── */
  .expect-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .expect-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .expect-num {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    flex-shrink: 0;
    padding-top: 0.1rem;
    min-width: 1.75rem;
  }

  .expect-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .side-panel {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .side-card {
      flex: 1;
      min-width: 260px;
    }
  }

  @media (max-width: 560px) {
    .side-panel {
      flex-direction: column;
    }

    .form-submit {
      width: 100%;
    }
  }
</style>
